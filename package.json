{
  "name": "confovhh",
  "version": "0.8.0",
  "private": false,
  "description": "Audit and triage workspace for GPCR–nanobody structural models",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darwinxcai/ConfoVHH.git"
  },
  "homepage": "https://github.com/darwinxcai/ConfoVHH#readme",
  "bugs": {
    "url": "https://github.com/darwinxcai/ConfoVHH/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "c8 --all --include='lib/**/*.{ts,tsx}' --include='app/**/*.{ts,tsx}' --include='worker/**/*.{ts,tsx}' --include='components/**/*.{ts,tsx}' --exclude='components/ui/**' --exclude='**/*.d.ts' --check-coverage --lines 83 --branches 83 --functions 83 --statements 83 node --test --test-concurrency=1 tests/*.test.mjs",
    "test:adversarial": "node scripts/run-adversarial-validation.mjs",
    "validate:prediction-runs": "node scripts/validate-real-prediction-runs.mjs",
    "build:verified": "bash scripts/build-verified.sh",
    "release:artifacts": "node scripts/create-release-artifacts.mjs",
    "release:verify": "node scripts/verify-release-artifact-generation.mjs",
    "qa:install": "npm --prefix qa ci",
    "qa:install-browsers": "npm --prefix qa exec playwright install --with-deps chromium",
    "qa:test": "npm --prefix qa test",
    "start": "next start"
  },
