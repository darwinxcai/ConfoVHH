    "outputBytes": 25000000000,
    "retries": 0
  },
  "planningGpuHours": {
    "colabfoldLower": 10,
    "colabfoldUpper": 30,
    "boltzLower": 10,
    "boltzUpper": 50,
    "measured": false
  },
  "failedAttemptPolicy": {
    "timeout": "retain-failed-ledger-row",
    "outOfMemory": "retain-failed-ledger-row",
    "nonfinite": "retain-failed-ledger-row",
    "malformed": "retain-failed-ledger-row",
    "resourceKill": "retain-failed-ledger-row",
