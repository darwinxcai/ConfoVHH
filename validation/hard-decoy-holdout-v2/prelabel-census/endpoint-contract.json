{
  "schemaVersion": "1.0.0",
  "dockq": {
    "package": "DockQ",
    "version": "2.1.3",
    "mapping": "AB:AB",
    "primaryPositiveRule": "DockQ>=0.23",
    "capriBands": {
      "incorrect": "0<=DockQ<0.23",
      "acceptable": "0.23<=DockQ<0.49",
      "medium": "0.49<=DockQ<0.80",
      "high": "0.80<=DockQ<=1"
    },
    "retainedFields": ["DockQ", "Fnat", "iRMSD", "LRMSD"]
  },
  "primaryEndpoints": [
    "independent-group-macro-average-precision",
    "independent-group-macro-average-precision-lift"
  ],
  "secondaryEndpoints": [
    "auroc",
    "expected-precision-at-1",
    "expected-precision-at-5",
    "expected-precision-at-10",
    "expected-success-at-1",
    "expected-success-at-5",
    "expected-success-at-10",
    "enrichment-factor-at-1-percent",
    "enrichment-factor-at-5-percent",
    "kendall-tau-b-versus-dockq",
    "supported-versus-other-odds-ratio",
    "supported-band-false-positive-rate"
  ],
  "tieRules": {
    "averagePrecision": "complete-score-block-entry",
    "auroc": "mann-whitney-with-half-credit-for-ties",
    "kendall": "tau-b",
    "topK": "expected-hypergeometric-boundary-tie",
    "enrichmentK": "max(1,ceil(p*n))"
  },
  "hierarchy": [
    "target-by-generator-stratum",
    "equal-generator-average-within-target",
    "equal-target-average-within-independent-group",
    "equal-independent-group-average"
  ],
  "pairedContrastPolicy": "same-rows-same-groups-difference-before-averaging",
  "averagePrecisionLiftPolicy": "stratum-AP-divided-by-stratum-prevalence-before-hierarchical-averaging",
  "missingClassPolicy": {
    "noPositives": "AP-AUROC-Kendall-unavailable; precision-and-success-at-k-zero",
    "allPositives": "discrimination-unavailable",
    "missingEligibleDockqOrConfoScore": "machinery-failure"
  },
  "bootstrap": {
    "replicates": 10000,
    "seed": 2046915371,
    "rng": "PCG64-DXSM",
    "interval": "type-7-percentile-2.5-and-97.5",
    "sampleUnits": ["independent-groups", "targets-within-selected-group"],
    "poseResampling": false,
    "generatorResampling": false,
    "pairedDrawsAcrossArms": true
  },
  "sensitivities": [
    "DockQ-cutoff-0.21",
    "DockQ-cutoff-0.23",
    "DockQ-cutoff-0.25",
    "exclude-absolute-distance-to-0.23-less-than-or-equal-to-0.02",
    "exclude-groups-violating-30-percent-development-identity",
    "leave-one-independent-group-out",
    "each-generator-separately"
  ],
  "scientificGate": {
    "logic": "intersection-union-all-required",
    "macroAuRocPointMinimum": 0.7,
    "macroAuRocLowerMinimumExclusive": 0.5,
    "macroApLiftLowerMinimumExclusive": 1,
    "supportedOddsRatioPointMinimum": 2,
    "supportedOddsRatioLowerMinimumExclusive": 1,
    "pairedApDifferenceVersusEveryBaseline": "point>0-and-lower>0",
    "pairedExpectedSuccessAt10VersusBootstrapMaximumBaseline": "point>=0.10-and-lower>0",
    "eachGenerator": "AP-lift>=1-and-AUROC>=0.50",
    "everySensitivity": "positive-AP-difference-versus-every-baseline",
    "everyLeaveOneGroupOut": "positive-AP-difference-versus-strongest-baseline",
    "missingGateQuantity": "fail"
  }
}
