<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="research-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">2</journal-id><journal-id journal-id-type="pmc-domain">pnas</journal-id><journal-title-group><journal-title>Proceedings of the National Academy of Sciences of the United States of America</journal-title><abbrev-journal-title>Proc Natl Acad Sci U S A</abbrev-journal-title></journal-title-group><publisher><publisher-name>National Academy of Sciences</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC12146711</article-id><article-id pub-id-type="pmcaid">12146711</article-id><article-id pub-id-type="pmcaiid">12146711</article-id><article-id pub-id-type="pmid">40440061</article-id><article-id pub-id-type="doi">10.1073/pnas.2501902122</article-id><title-group><article-title>Molecular basis for ligand recognition and receptor activation of the prostaglandin D2 receptor DP1</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Xu</surname><given-names initials="J">Jiuyin</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref ref-type="aff" rid="aff2">b</xref><xref rid="fn2" ref-type="author-notes">1</xref></contrib><contrib><name name-style="western"><surname>Wu</surname><given-names initials="Y">Yanli</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref rid="fn2" ref-type="author-notes">1</xref></contrib><contrib><name name-style="western"><surname>Xu</surname><given-names initials="Y">Youwei</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref rid="fn2" ref-type="author-notes">1</xref></contrib><contrib><name name-style="western"><surname>Li</surname><given-names initials="Y">Yang</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>He</surname><given-names initials="X">Xinheng</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Zhang</surname><given-names initials="H">Heng</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Wang</surname><given-names initials="JJ">James Jiqi</given-names></name><xref ref-type="aff" rid="aff3">c</xref></contrib><contrib><name name-style="western"><surname>Hou</surname><given-names initials="J">Jingjing</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref ref-type="aff" rid="aff4">d</xref></contrib><contrib><name name-style="western"><surname>Li</surname><given-names initials="J">Junrui</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Hu</surname><given-names initials="W">Wen</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Wu</surname><given-names initials="K">Kai</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Yuan</surname><given-names initials="Q">Qingning</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Wu</surname><given-names initials="C">Canrong</given-names></name><xref ref-type="aff" rid="aff5">e</xref><xref rid="cor1" ref-type="author-notes">2</xref></contrib><contrib><name name-style="western"><surname>Xu</surname><given-names initials="HE">H Eric</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref ref-type="aff" rid="aff2">b</xref><xref ref-type="aff" rid="aff5">e</xref><xref ref-type="aff" rid="aff6">f</xref><xref rid="cor1" ref-type="author-notes">2</xref></contrib></contrib-group><aff id="aff1"><label>a</label>State Key Laboratory of Drug Research, Shanghai Institute of Materia Medica, Chinese Academy of Sciences, Shanghai
