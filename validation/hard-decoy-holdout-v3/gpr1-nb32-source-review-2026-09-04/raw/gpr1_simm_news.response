<script>

	var dbxyjcg = document.getElementById("dbxyjcg");
	var tmd = document.getElementById("con").innerHTML;
	var str_ = "";
	var w_width = document.body.clientWidth;
//dbxyjcg.innerHTML=tmd;

if(w_width<1600){
	str_ = tmd.substring(0,170)+"...";
	dbxyjcg.innerHTML=str_;
}
if(w_width<1280){
	str_ = tmd.substring(0,150)+"...";
	dbxyjcg.innerHTML=str_;
}
	var dbxyjcg1 = document.getElementById("dbxyjcg1");
	var tmd1 = document.getElementById("con1").innerHTML;
	var str_1 = "";
	var w_width1 = document.body.clientWidth;
//dbxyjcg.innerHTML=tmd;

if(w_width1<1600){
	str_1 = tmd1.substring(0,182)+"...";
	dbxyjcg1.innerHTML=str_1;
}
if(w_width1<1280){
	str_1 = tmd1.substring(0,135)+"...";
	dbxyjcg1.innerHTML=str_1;
}
</script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
    var fullURL = window.location.href; // 获取完整的URL，包括协议、域名、路径和查询字符串
    var protocol = window.location.protocol; // 获取协议（http或https）
    var host = window.location.host; // 获取域名和端口（如果有）
    var path = window.location.pathname; // 获取路径
    var search = window.location.search; // 获取查询字符串（包括?）

    // console.log("完整URL: " + fullURL);
    // console.log("协议: " + protocol);
    // console.log("域名和端口: " + host);
    // console.log("路径: " + path);
    // console.log("查询字符串: " + search);

    if (host === 'www.simm.ac.cn') {
    var links = document.querySelectorAll('a');
    links.forEach(function(link) {
        var href = link.getAttribute('href');
        if (href.includes('simm.cas.cn') && href.includes('www.')) {
            href = href.replace('simm.cas.cn', 'simm.ac.cn');
        } else if (href.includes('simm.cas.cn') && !href.includes('www')  && href != 'http://english.simm.cas.cn/') {
            href = href.replace('simm.cas.cn', 'www.simm.ac.cn');
        }
        link.setAttribute('href', href);
    });
}
});
</script>
