            <section class="main-content">




                <article class="article">
                    <h4 class="title"><!--文章标题-->趋化素受体结构揭示脂质代谢调控新机制——Science最新研究成果解析GPR1信号调控全貌，为肥胖和炎症治疗提供新思路<!--文章标题--></h4>
                    <div class="share clearfix">
                        <span class="fl"><!--文章日期-->发表日期：<time datetime="2019-11-02">2025-11-21</time><!--文章日期--></span>

                        <span class="fr cas_share_list" id="cas_share_click">
