{"version":"6.9","hitCount":20,"request":{"queryString":"Nb32 AND (arrestin OR Fab30)","resultType":"core","cursorMark":"*","pageSize":100,"sort":"","synonym":false},"resultList":{"result":[{"id":"42243110","source":"MED","pmid":"42243110","pmcid":"PMC13396682","fullTextIdList":{"fullTextId":["PMC13396682"]},"doi":"10.1038/s41467-026-73968-3","title":"Structural dynamics of kappa opioid receptor interactions with β-arrestin 1.","authorString":"Han J, Fine EJ, Jiang Q, Zhuang Y, Suomivuori CM, Chen ZW, Denn E, Whiddon K, Li K, Evers AS, Fuller J, Carter J, Fay JF, Chen M, Dror RO, Che T.","authorList":{"author":[{"fullName":"Han J","firstName":"Jianming","lastName":"Han","initials":"J","authorId":{"type":"ORCID","value":"0009-0000-9929-750X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Clinical Pharmacology, Department of Anesthesiology, Washington University School of Medicine, Saint Louis, MO, USA. jianming@wustl.edu."}]}},{"fullName":"Fine EJ","firstName":"Eve J","lastName":"Fine","initials":"EJ","authorId":{"type":"ORCID","value":"0000-0001-7404-897X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Bioengineering, Stanford University, Stanford, CA, USA."},{"affiliation":"Department of Computer Science, Stanford University, Stanford, CA, USA."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University, Stanford, CA, USA."},{"affiliation":"Department of Structural Biology, Stanford University, Stanford, CA, USA."},{"affiliation":"Institute for Computational and Mathematical Engineering, Stanford University, Stanford, CA, USA."}]}},{"fullName":"Jiang Q","firstName":"Qianru","lastName":"Jiang","initials":"Q","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Clinical Pharmacology, Department of Anesthesiology, Washington University School of Medicine, Saint Louis, MO, USA."}]}},{"fullName":"Zhuang Y","firstName":"Yuxuan","lastName":"Zhuang",