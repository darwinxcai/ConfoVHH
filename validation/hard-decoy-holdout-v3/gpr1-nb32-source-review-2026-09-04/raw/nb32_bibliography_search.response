Cleveland, OH, USA."}]}},{"fullName":"Li K","firstName":"Kunpeng","lastName":"Li","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacology, Case Western Reserve University, Cleveland, OH, USA."}]}},{"fullName":"Evers AS","firstName":"Alex S","lastName":"Evers","initials":"AS","authorId":{"type":"ORCID","value":"0000-0002-0342-0575"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Basic Research, Department of Anesthesiology, Washington University School of Medicine, Saint Louis, MO, USA."}]}},{"fullName":"Fuller J","firstName":"James","lastName":"Fuller","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-9029-0923"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Helix Biostructures, Indianapolis, IN, USA."}]}},{"fullName":"Carter J","firstName":"Joshua","lastName":"Carter","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-7322-349X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Helix Biostructures, Indianapolis, IN, USA."}]}},{"fullName":"Fay JF","firstName":"Jonathan F","lastName":"Fay","initials":"JF","authorId":{"type":"ORCID","value":"0000-0003-1822-2384"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry and Molecular Biology, University of Maryland Baltimore, Baltimore, MD, USA."}]}},{"fullName":"Chen M","firstName":"Muyuan","lastName":"Chen","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-1311-7868"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SLAC National Accelerator Laboratory, Stanford University, Menlo Park, CA, USA."}]}},{"fullName":"Dror RO","firstName":"Ron O","lastName":"Dror","initials":"RO","authorId":{"type":"ORCID","value":"0000-0002-6418-2793"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, Stanford University, Stanford, CA, USA."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University, Stanford, CA, USA."},{"affiliation":"Department of Structural Biology, Stanford University, Stanford, CA, USA."},{"affiliation":"Institute for Computational and Mathematical Engineering, Stanford University, Stanford, CA, USA."}]}},{"fullName":"Che T","firstName":"Tao","lastName":"Che","initials":"T","authorId":{"type":"ORCID","value":"0000-0002-1620-3027"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Clinical Pharmacology, Department of Anesthesiology, Washington University School of Medicine, Saint Louis, MO, USA. taoche@wustl.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7322-349X"},{"type":"ORCID","value":"0000-0001-7404-897X"},{"type":"ORCID","value":"0000-0002-0342-0575"},{"type":"ORCID","value":"0000-0002-1620-3027"},{"type":"ORCID","value":"0000-0002-2445-8791"},{"type":"ORCID","value":"0000-0002-6418-2793"},{"type":"ORCID","value":"0000-0002-9029-0923"},{"type":"ORCID","value":"0000-0003-1311-7868"},{"type":"ORCID","value":"0000-0003-1822-2384"},{"type":"ORCID","value":"0000-0003-4390-8556"},{"type":"ORCID","value":"0009-0000-9929-750X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"17","journalIssueId":4204868,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Nature communications","medlineAbbreviation":"Nat Commun","isoabbreviation":"Nat Commun","essn":"2041-1723","issn":"2041-1723","nlmid":"101528555"}},"pubYear":"2026","pageInfo":"7171","abstractText":"Opioid receptors signal through Gi/o protein and β-arrestin pathways that mediate distinct effects of opiate drugs. While opioid binding and G protein activation are well studied, β-arrestin recruitment remains poorly understood. Here, we determine the complex structure of the kappa opioid receptor (KOR) with β-arrestin1 (βarr1) at 2.60 Å resolution using cryogenic electron microscopy. Structural and mass spectrometry analyses reveal multiple phosphorylation sites and a phospholipid-binding site that specifically enhances arrestin recruitment. The KOR-βarr1 complex adopts a core interaction and exhibits notable differences from other GPCR-βarr1 complexes. Comparisons with the structures of KOR-Nb39 and KOR-Gi1 complexes also reveal distinct structural features in the orthosteric binding site and the KOR-transducer interface that affect signaling bias. Using extensive 3D variation analysis and molecular dynamics simulations, we identify a range of conformational dynamics in both the receptor and βarr1, suggesting an allosteric pathway for arrestin's entry and exit.","affiliation":"Center for Clinical Pharmacology, Department of Anesthesiology, Washington University School of Medicine, Saint Louis, MO, USA. jianming@wustl.edu.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"R35GM143061","agency":"U.S. Department of Health & Human Services | NIH | National Institute of General Medical Sciences (NIGMS)","orderIn":0},{"grantId":"R35 GM143061","agency":"NIGMS NIH HHS","acronym":"GM","orderIn":0},{"grantId":"R01 DA058020","agency":"NIDA NIH HHS","acronym":"DA","orderIn":0},{"grantId":"R35GM143061","agency":"U.S. Department of Health &amp; Human Services | NIH | National Institute of General Medical Sciences","orderIn":0},{"grantId":"R01DA058020","agency":"U.S. Department of Health & Human Services | NIH | National Institute on Drug Abuse (NIDA)","orderIn":0},{"grantId":"R01DA058020","agency":"U.S. Department of Health &amp; Human Services | NIH | National Institute on Drug Abuse","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Receptors, Opioid, kappa","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Cryoelectron Microscopy"},{"majorTopic_YN":"N","descriptorName":"Signal Transduction"},{"majorTopic_YN":"N","descriptorName":"Binding Sites"},{"majorTopic_YN":"N","descriptorName":"Protein Conformation"},{"majorTopic_YN":"N","descriptorName":"Protein Binding"},{"majorTopic_YN":"N","descriptorName":"Phosphorylation"},{"majorTopic_YN":"N","descriptorName":"Molecular Dynamics Simulation"},{"majorTopic_YN":"N","descriptorName":"HEK293 Cells"},{"majorTopic_YN":"Y","descriptorName":"beta-Arrestin 1","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}}]},"chemicalList":{"chemical":[{"name":"Receptors, Opioid, kappa","registryNumber":"0"},{"name":"beta-Arrestin 1","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41467-026-73968-3"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13396682"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13396682?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-23","dateOfCreation":"2026-06-04","firstIndexDate":"2026-06-06","fullTextReceivedDate":"2026-09-03","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-04","firstPublicationDate":"2026-06-04"},{"id":"41720803","source":"MED","pmid":"41720803","pmcid":"PMC13035853","fullTextIdList":{"fullTextId":["PMC13035853"]},"doi":"10.1038/s41467-026-69884-1","title":"Mechanism of beta-arrestin 1 mediated Src activation via Src SH3 domain revealed by cryo-electron microscopy.","authorString":"Pakharukova N, Thomas BN, Bansia H, Li L, Bassford DK, Abzalimov RR, Kim J, Kahsai AW, Pani B, Xiao K, Ochakovski R, Liu S, Zhang X, Ahn S, des Georges A, Lefkowitz RJ.","authorList":{"author":[{"fullName":"Pakharukova N","firstName":"Natalia","lastName":"Pakharukova","initials":"N","authorId":{"type":"ORCID","value":"0000-0002-8363-6105"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA."},{"affiliation":"Howard Hughes Medical Institute, Duke University Medical Center, Durham, NC, 27710, USA."}]}},{"fullName":"Thomas BN","firstName":"Brittany N","lastName":"Thomas","initials":"BN","authorId":{"type":"ORCID","value":"0000-0001-8317-7538"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA."},{"affiliation":"Howard Hughes Medical Institute, Duke University Medical Center, Durham, NC, 27710, USA."}]}},{"fullName":"Bansia H","firstName":"Harsh","lastName":"Bansia","initials":"H","authorId":{"type":"ORCID","value":"0000-0002-6738-8754"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular Pathobiology, College