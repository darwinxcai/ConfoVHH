lsList":{"authorAffiliation":[{"affiliation":"Center for Proteomics & Artificial Intelligence, Allegheny Health Network Cancer Institute, Pittsburgh, PA, 15202, USA."},{"affiliation":"Department of Biomedical Engineering, College of Engineering, Carnegie Mellon University, Pittsburgh, PA, 15213, USA."}]}},{"fullName":"Ochakovski R","firstName":"Roni","lastName":"Ochakovski","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA."}]}},{"fullName":"Liu S","firstName":"Shibo","lastName":"Liu","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology Initiative, CUNY Advanced Science Research Center, New York, NY, 10031, USA."}]}},{"fullName":"Zhang X","firstName":"Xingdong","lastName":"Zhang","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA."}]}},{"fullName":"Ahn S","firstName":"Seungkirl","lastName":"Ahn","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-5681-3789"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA."}]}},{"fullName":"des Georges A","firstName":"Amedee","lastName":"des Georges","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-9704-3781"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular Pathobiology, College of Dentistry, New York University, New York, 10010, USA. a.des.georges@nyu.edu."},{"affiliation":"Pain Research Center, New York University, New York, 10010, USA. a.des.georges@nyu.edu."},{"affiliation":"Structural Biology Initiative, CUNY Advanced Science Research Center, New York, NY, 10031, USA. a.des.georges@nyu.edu."}]}},{"fullName":"Lefkowitz RJ","firstName":"Robert J","lastName":"Lefkowitz","initials":"RJ","authorId":{"type":"ORCID","value":"0000-0003-1472-7545"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA. lefko001@receptor-biol.duke.edu."},{"affiliation":"Howard Hughes Medical Institute, Duke University Medical Center, Durham, NC, 27710, USA. lefko001@receptor-biol.duke.edu."},{"affiliation":"Department of Biochemistry, Duke University Medical Center, Durham, NC, 27710, USA. lefko001@receptor-biol.duke.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5681-3789"},{"type":"ORCID","value":"0000-0001-8317-7538"},{"type":"ORCID","value":"0000-0002-1069-1226"},{"type":"ORCID","value":"0000-0002-6738-8754"},{"type":"ORCID","value":"0000-0002-8302-7860"},{"type":"ORCID","value":"0000-0002-8363-6105"},{"type":"ORCID","value":"0000-0002-9704-3781"},{"type":"ORCID","value":"0000-0003-1472-7545"},{"type":"ORCID","value":"0000-0003-2110-1532"},{"type":"ORCID","value":"0000-0003-4811-4632"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","related_data"]},"journalInfo":{"issue":"1","volume":"17","journalIssueId":4112748,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"Nature communications","medlineAbbreviation":"Nat Commun","isoabbreviation":"Nat Commun","essn":"2041-1723","issn":"2041-1723","nlmid":"101528555"}},"pubYear":"2026","pageInfo":"2973","abstractText":"Beta-arrestins (βarrs) are key regulators and transducers of G-protein coupled receptor signaling; however, little is known of how βarrs communicate with their downstream effectors. Here, we delineate structural mechanisms underlying βarr-mediated signal transduction. Using cryo-electron microscopy, we elucidate how βarr1 recruits and activates the non-receptor tyrosine kinase Src, a well-established signaling partner of βarrs. βarr1 engages Src SH3 through two distinct sites, each employing a different recognition mechanism: a polyproline motif in the N-domain and a non-proline-based interaction in the central crest region. At both sites βarr1 interacts with the aromatic surface of SH3, disrupting the autoinhibited conformation of Src and directly triggering its allosteric activation. This structural evidence establishes βarr1 as an active regulatory protein rather than a passive scaffold and suggests a potentially general mechanism for βarr-mediated signaling across diverse effectors.","affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, 27710, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"R01 HL16037","agency":"U.S. Department of Health & Human Services | NIH | National Heart, Lung, and Blood Institute (NHLBI)","orderIn":0},{"grantId":"R35 GM133598","agency":"NIGMS NIH HHS","acronym":"GM","orderIn":0},{"grantId":"ALTF 1071-2017","agency":"European Molecular Biology Organization (EMBO)","orderIn":0},{"grantId":"LT000174/2018","agency":"Human Frontier Science Program (HFSP)","orderIn":0},{"grantId":"R35GM133598","agency":"U.S. Department of Health & Human Services | NIH | National Institute of General Medical Sciences (NIGMS)","orderIn":0},{"grantId":"2023CHAL4223","agency":"Prostate Cancer Foundation (PCF)","orderIn":0},{"grantId":"S10 OD036268","agency":"NIH HHS","acronym":"OD","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"src-Family Kinases","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Cryoelectron Microscopy"},{"majorTopic_YN":"N","descriptorName":"Signal Transduction"},{"majorTopic_YN":"Y","descriptorName":"src Homology Domains"},{"majorTopic_YN":"N","descriptorName":"Protein Binding"},{"majorTopic_YN":"N","descriptorName":"Models, Molecular"},{"majorTopic_YN":"Y","descriptorName":"beta-Arrestin 1","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}}]},"chemicalList":{"chemical":[{"name":"src-Family Kinases","registryNumber":"EC 2.7.10.2"},{"name":"beta-Arrestin 1","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41467-026-69884-1"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13035853"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13035853?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"39131402","source":"MED","reference":"bioRxiv. 2025 Sep 27:2024.07.31.605623. doi: 10.1101/2024.07.31.605623.","type":"Update of","orderIn":1},{"id":"PPR889825","source":"PPR","type":"Preprint in","note":"CrossRef Pre-print loader","orderIn":10002}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"Y","dbCrossReferenceList":{"dbName":["PDB"]},"hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen","pdb"]},"dateOfCompletion":"2026-07-08","dateOfCreation":"2026-02-20","firstIndexDate":"2026-02-21","fullTextReceivedDate":"2026-04-01","dateOfRevision":"2026-09-01","electronicPublicationDate":"2026-02-20","firstPublicationDate":"2026-02-20"},{"id":"41562307","source":"MED","pmid":"41562307","pmcid":"PMC12820791","fullTextIdList":{"fullTextId":["PMC12820791"]},"doi":"10.1002/pro.70474","title":"Deceptive beauty of non-natural structures.","authorString":"Gurevich VV, Gurevich EV.","authorList":{"author":[{"fullName":"Gurevich VV","firstName":"Vsevolod V","lastName":"Gurevich","initials":"VV","authorId":{"type":"ORCID","value":"0000-0002-3950-5351"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacology, Vanderbilt University, Nashville, Tennessee, USA."}]}},{"fullName":"Gurevich EV","firstName":"Eugenia V","lastName":"Gurevich","initials":"EV","authorId":{"type":"ORCID","value":"0000-0002-0563-8295"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacology, Vanderbilt University, Nashville, Tennessee, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0563-8295"},{"type":"ORCID","value":"0000-0002-3950-5351"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"2","volume":"35","journalIssueId":4096020,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"Protein science : a publication of the Protein Society","medlineAbbreviation":"Protein Sci","isoabbreviation":"Protein Sci","essn":"1469-896X","issn":"0961-8368","nlmid":"9211750"}},"pubYear":"2026","pageInfo":"e70474","abstractText":"Structures of proteins and multiprotein complexes are considered landmark achievements. However, in many cases, mutant proteins are used for structural work. Even when wild type proteins are used, crystallization or complex formation for cryoEM is performed in highly nonphysiological conditions. This explains why the structures can be inconsistent with the functional data. The structures are always true, but solved structures faithfully reveal the mode of interactions of the proteins used in the conditions employed. The structures are static, whereas proteins are dynamic. Even when a series of structures are solved, the dynamics are only implied or deduced via molecular dynamics simulations. The mechanisms of protein function in the natural environment can be revealed by the combination of structural, biochemical, biophysical, and in vivo studies, supplemented by molecular modeling.","affiliation":"Department of Pharmacology, Vanderbilt University, Nashville, Tennessee, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"EY011500","agency":"National Institutes of Health","orderIn":0},{"grantId":"EY011500","agency":"NIH HHS","acronym":"NH","orderIn":0},{"grantId":"R01 EY011500","agency":"NEI NIH HHS","acronym":"EY","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Proteins","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Protein Conformation"},{"majorTopic_YN":"N","descriptorName":"Models, Molecular"},{"majorTopic_YN":"N","descriptorName":"Molecular Dynamics Simulation"}]},"keywordList":{"keyword":["Arrestin","protein structure","Gpcr","Protein–protein Interactions"]},"chemicalList":{"chemical":[{"name":"Proteins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1002/pro.70474"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12820791"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12820791?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb"]},"dateOfCompletion":"2026-06-30","dateOfCreation":"2026-01-21","firstIndexDate":"2026-01-22","fullTextReceivedDate":"2026-01-22","dateOfRevision":"2026-06-30","firstPublicationDate":"2026-02-01"},{"id":"41544164","source":"MED","pmid":"41544164","pmcid":"PMC12810643","fullTextIdList":{"fullTextId":["PMC12810643"]},"doi":"10.1126/sciadv.adz5662","title":"FLIPs: Genetically encoded molecular biosensors for functional imaging of cell signaling by linear dichroism microscopy.","authorString":"Miclea P, Nagy-Marková V, Van den Eynde R, Vandenberg W, Sakhi A, Bondar A, Myšková J, Dedecker P, Lazar J.","authorList":{"author":[{"fullName":"Miclea P","firstName":"Paul","lastName":"Miclea","initials":"P","authorId":{"type":"ORCID","value":"0000-0002-3910-4574"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia."},{"affiliation":"Innovative Bioimaging, s.r.o., Podolská 1490/6, 147 00 Prague 4, Czechia."}]}},{"fullName":"Nagy-Marková V","firstName":"Vendula","lastName":"Nagy-Marková","initials":"V","authorId":{"type":"ORCID","value":"0000-0003-0373-9858"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia."},{"affiliation":"Innovative Bioimaging, s.r.o., Podolská 1490/6, 147 00 Prague 4, Czechia."}]}},{"fullName":"Van den Eynde R","firstName":"Robin","lastName":"Van den Eynde","initials":"R","authorId":{"type":"ORCID","value":"0000-0001-6548-3312"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry, Molecular and Structural Biology, KU Leuven, Celestijnenlaan 200G, 3001 Heverlee, Belgium."}]}},{"fullName":"Vandenberg W","firstName":"Wim","lastName":"Vandenberg","initials":"W","authorId":{"type":"ORCID","value":"0000-0002-5888-9100"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry, Molecular and Structural Biology, KU Leuven, Celestijnenlaan 200G, 3001 Heverlee, Belgium."}]}},{"fullName":"Sakhi A","firstName":"Alina","lastName":"Sakhi","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Organic Chemistry and Biochemistry, Czech Academy of Sciences, Flemingovo nám. 2, 160 00 Prague, Czechia."}]}},{"fullName":"Bondar A","firstName":"Alexey","lastName":"Bondar","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-1980-2930"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia."},{"affiliation":"Institute of Plant Molecular Biology, Biology Center of the Czech Academy of Sciences, Branišovská 1160/30, Budweis, Czechia."},{"affiliation":"University of South Bohemia, Faculty of Science, Branišovská 1160/30, Budweis, Czechia."}]}},{"fullName":"Myšková J","firstName":"Jitka","lastName":"Myšková","initials":"J","authorId":{"type":"ORCID","value":"0000-0003-1034-1792"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia."}]}},{"fullName":"Dedecker P","firstName":"Peter","lastName":"Dedecker","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry, Molecular and Structural Biology, KU Leuven, Celestijnenlaan 200G, 3001 Heverlee, Belgium."},{"affiliation":"Université de Lille, LASIRe CNRS, 59655 Villeneuve, France."}]}},{"fullName":"Lazar J","firstName":"Josef","lastName":"Lazar","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-6285-3995"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia."},{"affiliation":"Innovative Bioimaging, s.r.o., Podolská 1490/6, 147 00 Prague 4, Czechia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6548-3312"},{"type":"ORCID","value":"0000-0002-1980-2930"},{"type":"ORCID","value":"0000-0002-3910-4574"},{"type":"ORCID","value":"0000-0002-5888-9100"},{"type":"ORCID","value":"0000-0002-6285-3995"},{"type":"ORCID","value":"0000-0003-0373-9858"},{"type":"ORCID","value":"0000-0003-1034-1792"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"3","volume":"12","journalIssueId":4092437,"dateOfPublication":"2026 Jan","monthOfPublication":1,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Science advances","medlineAbbreviation":"Sci Adv","isoabbreviation":"Sci Adv","essn":"2375-2548","issn":"2375-2548","nlmid":"101653440"}},"pubYear":"2026","pageInfo":"eadz5662","abstractText":"Genetically encoded fluorescent biosensors convert specific biomolecular events into optically detectable signals. However, imaging biomolecular processes often requires modifying the proteins involved, and many molecular processes are still to be imaged. Here, we present a biosensor design that uses a hitherto overlooked detection principle: directionality of optical properties of fluorescent proteins. The biosensors (termed FLIPs) offer an extremely simple design, high sensitivity, multiplexing capability, ratiometric readout, and other advantages, without requiring modifications to their targets. We demonstrate the sensor performance by real-time imaging activity of G protein-coupled receptors (GPCRs), G proteins, arrestins, and other membrane-associated proteins, as well as by identifying a previously undescribed, pronounced, endocytosis-associated conformational change in a GPCR-β-arrestin complex. In combination with an original tri-scanning linear dichroism confocal microscope, FLIPs allow unparalleled imaging of activity of nonmodified, endogenously expressed G proteins. Thus, FLIPs establish a powerful molecular platform for imaging cell signaling, allowing numerous future developments and insights.","affiliation":"First Faculty of Medicine, Charles University in Prague, Kateřinská 32, 121 08 Prague, Czechia.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"101113439","agency":"European Research Council","orderIn":0},{"grantId":"23-05983S","agency":"Czech Science Foundation","orderIn":0},{"grantId":"LTAIN19167","agency":"Ministry of Education, Youth and Science of the Czech Republic","orderIn":0},{"grantId":"101131014","agency":"European Innovation Council","orderIn":0},{"grantId":"G010723N","agency":"Vlaamse regering","orderIn":0},{"grantId":"PathFinder project 101131014 UniSens","agency":"European Innovation Council","orderIn":0},{"grantId":"12A7225N","agency":"Vlaamse regering","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"GTP-Binding Proteins","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Luminescent Proteins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Receptors, G-Protein-Coupled","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Microscopy, Confocal"},{"majorTopic_YN":"Y","descriptorName":"Biosensing Techniques","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Signal Transduction"},{"majorTopic_YN":"N","descriptorName":"beta-Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}}]},"chemicalList":{"chemical":[{"name":"Luminescent Proteins","registryNumber":"0"},{"name":"GTP-Binding Proteins","registryNumber":"EC 3.6.1.-"},{"name":"Receptors, G-Protein-Coupled","registryNumber":"0"},{"name":"beta-Arrestins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1126/sciadv.adz5662"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12810643"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12810643?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb","doi"]},"dateOfCompletion":"2026-06-26","dateOfCreation":"2026-01-16","firstIndexDate":"2026-01-17","fullTextReceivedDate":"2026-01-17","dateOfRevision":"2026-06-26","electronicPublicationDate":"2026-01-16","firstPublicationDate":"2026-01-16"},{"id":"40924451","source":"MED","pmid":"40924451","pmcid":"PMC12452856","fullTextIdList":{"fullTextId":["PMC12452856"]},"doi":"10.1073/pnas.2507384122","title":"A genetically encoded nanobody sensor reveals conformational diversity in β-arrestins orchestrated by distinct seven transmembrane receptors.","authorString":"Sarma P, Nagy Marková V, Dalal A, Mishra S, Zaidi N, Tiwari D, Yadav MK, Roy N, Mahajan G, Miclea P, Lazar J, Shukla AK.","authorList":{"author":[{"fullName":"Sarma P","firstName":"Parishmita","lastName":"Sarma","initials":"P","authorId":{"type":"ORCID","value":"0000-0001-5519-7160"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Nagy Marková V","firstName":"Vendula","lastName":"Nagy Marková","initials":"V","authorId":{"type":"ORCID","value":"0009-0002-8808-3244"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Prague 121 08, Czech Republic."},{"affiliation":"Institute of Organic Chemistry and Biochemistry Czech Academy of Sciences, Prague 160 00, Czech Republic."},{"affiliation":"Faculty of Science, Charles University in Prague, Prague 128 00, Czech Republic."}]}},{"fullName":"Dalal A","firstName":"Annu","lastName":"Dalal","initials":"A","authorId":{"type":"ORCID","value":"0009-0002-1762-7339"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Mishra S","firstName":"Sudha","lastName":"Mishra","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Zaidi N","firstName":"Nashrah","lastName":"Zaidi","initials":"N","authorId":{"type":"ORCID","value":"0009-0002-2327-6942"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Tiwari D","firstName":"Divyanshu","lastName":"Tiwari","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Yadav MK","firstName":"Manish K","lastName":"Yadav","initials":"MK","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Roy N","firstName":"Nabarun","lastName":"Roy","initials":"N","authorId":{"type":"ORCID","value":"0009-0002-8449-7941"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Mahajan G","firstName":"Gargi","lastName":"Mahajan","initials":"G","authorId":{"type":"ORCID","value":"0009-0004-6779-253X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}},{"fullName":"Miclea P","firstName":"Paul","lastName":"Miclea","initials":"P","authorId":{"type":"ORCID","value":"0000-0002-3910-4574"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Prague 121 08, Czech Republic."},{"affiliation":"Institute of Organic Chemistry and Biochemistry Czech Academy of Sciences, Prague 160 00, Czech Republic."}]}},{"fullName":"Lazar J","firstName":"Josef","lastName":"Lazar","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-6285-3995"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"First Faculty of Medicine, Charles University in Prague, Prague 121 08, Czech Republic."},{"affiliation":"Institute of Organic Chemistry and Biochemistry Czech Academy of Sciences, Prague 160 00, Czech Republic."}]}},{"fullName":"Shukla AK","firstName":"Arun K","lastName":"Shukla","initials":"AK","authorId":{"type":"ORCID","value":"0000-0003-2910-8288"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5519-7160"},{"type":"ORCID","value":"0000-0002-3910-4574"},{"type":"ORCID","value":"0000-0002-6285-3995"},{"type":"ORCID","value":"0000-0003-2910-8288"},{"type":"ORCID","value":"0009-0002-1762-7339"},{"type":"ORCID","value":"0009-0002-2327-6942"},{"type":"ORCID","value":"0009-0002-8449-7941"},{"type":"ORCID","value":"0009-0002-8808-3244"},{"type":"ORCID","value":"0009-0003-3916-1872"},{"type":"ORCID","value":"0009-0004-6779-253X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"37","volume":"122","journalIssueId":4010219,"dateOfPublication":"2025 Sep","monthOfPublication":9,"yearOfPublication":2025,"printPublicationDate":"2025-09-01","journal":{"title":"Proceedings of the National Academy of Sciences of the United States of America","medlineAbbreviation":"Proc Natl Acad Sci U S A","isoabbreviation":"Proc Natl Acad Sci U S A","essn":"1091-6490","issn":"0027-8424","nlmid":"7505876"}},"pubYear":"2025","pageInfo":"e2507384122","abstractText":"Agonist-induced interaction of G protein-coupled receptors (GPCRs) with β-arrestins (βarrs) is a critical mechanism that regulates the spatiotemporal pattern of receptor localization and signaling. While the underlying mechanism governing GPCR-βarr interaction is primarily conserved and involves receptor activation and phosphorylation, there are several examples of receptor-specific fine-tuning of βarr-mediated functional outcomes. Considering the key contribution of conformational plasticity of βarrs in driving receptor-specific functional responses, it is important to develop novel sensors capable of reporting distinct βarr conformations in cellular context. Here, we design an intrabody version of a βarr-recognizing nanobody (nanobody32), referred to as intrabody32 (Ib32), in NanoLuc enzyme complementation assay format and measure its ability to recognize βarr1 and 2 in live cells upon activation of a broad set of GPCRs. Ib32 robustly recognizes activated βarr1 and 2 in the plasma membrane and endosomes, and effectively mirrors βarr recruitment profile upon stimulation of selected GPCRs. We also design an Ib32 sensor for polarization microscopy with a change in linear dichroism as readout and demonstrate its utility for monitoring βarr activation upon stimulation of selected GPCRs by natural and biased agonists. Taken together with a previously described sensor of βarr1 activation, Ib32 underscores the inherent flexibility encoded in βarrs and conformational diversity imparted by different GPCRs, which is further corroborated using an orthogonal limited proteolysis assay. Our study presents Ib32 as a sensor of βarr activation and highlights the structural diversity of βarrs, which likely allows their ability to interact with, and regulate, a large repertoire of GPCRs.","affiliation":"Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur 208016, India.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"File No. DST/INT/Czech/P-03/2019","agency":"Department of Science and Technology, Ministry of Science and Technology, India","orderIn":0},{"grantId":"IA/S/20/1/504916","agency":"DBT/Wellcome Trust India Alliance","acronym":"WTDBT_","orderIn":0},{"grantId":"IA/S/20/1/504916","agency":"Wellcome Trust DBT India Alliance (India Alliance)","orderIn":0},{"grantId":"File No. DST/INT/Czech/P-03/2019","agency":"Department of Science and Technology, Ministry of Science and Technology, India (DST)","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Cell Membrane","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Receptors, G-Protein-Coupled","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Biosensing Techniques","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Signal Transduction"},{"majorTopic_YN":"N","descriptorName":"Protein Conformation"},{"majorTopic_YN":"N","descriptorName":"HEK293 Cells"},{"majorTopic_YN":"Y","descriptorName":"Single-Domain Antibodies","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"beta-Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}}]},"keywordList":{"keyword":["Polarization microscopy","Gpcrs","Nanobodies","Β-arrestins","Intrabodies"]},"chemicalList":{"chemical":[{"name":"Receptors, G-Protein-Coupled","registryNumber":"0"},{"name":"Single-Domain Antibodies","registryNumber":"0"},{"name":"beta-Arrestins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1073/pnas.2507384122"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12452856"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12452856?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"PPR811082","source":"PPR","type":"Preprint in","note":"CrossRef Pre-print loader","orderIn":10002}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb","doi"]},"dateOfCompletion":"2025-09-09","dateOfCreation":"2025-09-09","firstIndexDate":"2025-09-09","fullTextReceivedDate":"2026-03-09","dateOfRevision":"2026-08-13","electronicPublicationDate":"2025-09-09","firstPublicationDate":"2025-09-09"},{"id":"41795245","source":"MED","pmid":"41795245","pmcid":"PMC13169046","fullTextIdList":{"fullTextId":["PMC13169046"]},"doi":"10.1016/j.molpha.2026.100110","title":"Nanobodies unlock new mechanisms to target G protein-coupled receptors.","authorString":"Skiba MA.","authorList":{"author":[{"fullName":"Skiba MA","firstName":"Meredith A","lastName":"Skiba","initials":"MA","authorId":{"type":"ORCID","value":"0000-0003-4615-6775"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biological Chemistry, University of Michigan School of Medicine, Ann Arbor, Michigan; Department of Pharmacology, University of Michigan School of Medicine, Ann Arbor, Michigan. Electronic address: skibam@umich.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-4615-6775"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"4","volume":"108","journalIssueId":4186998,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Molecular pharmacology","medlineAbbreviation":"Mol Pharmacol","isoabbreviation":"Mol Pharmacol","essn":"1521-0111","issn":"0026-895X","nlmid":"0035623"}},"pubYear":"2026","pageInfo":"100110","abstractText":"Once considered tools to aid structural studies, single-domain antibodies (nanobodies) have emerged as a new class of G protein-coupled receptor (GPCR) ligands. Aided by camelid immunization and advances in synthetic nanobody library development and computational design platforms, nanobody discovery has expanded to all major GPCR families. Unlike traditional small-molecule ligands, nanobodies can engage extended nonconserved extracellular epitopes to stabilize distinct receptor conformations to achieve high receptor selectivity and enable unique modes of pharmacological modulation. Integration of these properties with classical antibody engineering approaches, such as the generation of bispecific or bivalent constructs, has the potential to enable additional therapeutic strategies, such as cell and tissue-specific targeting. Recent mechanistic studies provide insight into the strategies nanobodies employ to function as agonists, antagonists, inverse agonists, and allosteric modulators. These studies begin to reveal the general principles nanobodies use to selectively engage and regulate GPCRs and uncover strategies to evolve their pharmacological properties. Continued advancements in discovery methods will expand the repertoire of nanobody ligands across additional GPCRs and deepen our mechanistic understanding to accelerate the development of the next generation of GPCR therapeutics. SIGNIFICANCE STATEMENT: G protein-coupled receptors (GPCRs) are one of the most successful targets of small-molecule drugs but are virtually untouched by antibody therapeutics. Aided by advances in discovery strategies, nanobodies have emerged as an ideal antibody scaffold to modulate GPCR signaling. Recent mechanistic studies reveal the molecular approaches nanobodies employ to target GPCRs, providing new insight into their potential as therapeutic tools. These findings provide a path toward developing nanobodies to regulate GPCR function in diverse disease contexts.","affiliation":"Department of Biological Chemistry, University of Michigan School of Medicine, Ann Arbor, Michigan; Department of Pharmacology, University of Michigan School of Medicine, Ann Arbor, Michigan. Electronic address: skibam@umich.edu.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"R00 HD110612","agency":"NICHD NIH HHS","acronym":"HD","orderIn":0},{"agency":"Eunice Kennedy Shriver National Institute of Child Health and Human Development","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Receptors, G-Protein-Coupled","meshQualifierList":{"meshQualifier":[{"abbreviation":"AI","qualifierName":"antagonists & inhibitors","majorTopic_YN":"N"},{"abbreviation":"IM","qualifierName":"immunology","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"},{"abbreviation":"AG","qualifierName":"agonists","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Ligands"},{"majorTopic_YN":"Y","descriptorName":"Single-Domain Antibodies","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"PD","qualifierName":"pharmacology","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}}]},"keywordList":{"keyword":["G protein-coupled receptor","Single-domain antibody","Nanobody"]},"chemicalList":{"chemical":[{"name":"Ligands","registryNumber":"0"},{"name":"Receptors, G-Protein-Coupled","registryNumber":"0"},{"name":"Single-Domain Antibodies","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.molpha.2026.100110"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13169046"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13169046?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen","pdb"]},"dateOfCompletion":"2026-07-10","dateOfCreation":"2026-03-08","firstIndexDate":"2026-03-10","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-13","firstPublicationDate":"2026-02-13"},{"id":"33605032","source":"MED","pmid":"33605032","pmcid":"PMC8252779","fullTextIdList":{"fullTextId":["PMC8252779"]},"doi":"10.1111/febs.15773","title":"Signaling at the endosome: cryo-EM structure of a GPCR-G protein-beta-arrestin megacomplex.","authorString":"Nguyen AH, Lefkowitz RJ.","authorList":{"author":[{"fullName":"Nguyen AH","firstName":"Anthony H","lastName":"Nguyen","initials":"AH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, USA."}]}},{"fullName":"Lefkowitz RJ","firstName":"Robert J","lastName":"Lefkowitz","initials":"RJ","authorId":{"type":"ORCID","value":"0000-0003-1472-7545"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, USA."},{"affiliation":"Howard Hughes Medical Institute, Duke University Medical Center, Durham, NC, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-1472-7545"}]},"journalInfo":{"issue":"8","volume":"288","journalIssueId":3152729,"dateOfPublication":"2021 Apr","monthOfPublication":4,"yearOfPublication":2021,"printPublicationDate":"2021-04-01","journal":{"title":"The FEBS journal","medlineAbbreviation":"FEBS J","isoabbreviation":"FEBS J","essn":"1742-4658","issn":"1742-464X","nlmid":"101229646"}},"pubYear":"2021","pageInfo":"2562-2569","abstractText":"G protein-coupled receptors (GPCRs) are a large class of cell-surface receptor involved in cellular signaling that are currently the target of over one third of all clinically approved therapeutics. Classically, an agonist-bound, active GPCR couples to and activates G proteins through the receptor intracellular core. To attenuate G protein signaling, the GPCR is phosphorylated at its C-terminal tail and/or relevant intracellular loops, allowing for the recruitment of β-arrestins (βarrs). βarrs then couple to the receptor intracellular core in order to mediate receptor desensitization and internalization. However, our laboratory and others have observed that some GPCRs are capable of continuously signaling through G protein even after internalization. This mode of sustained signaling stands in contrast with our previous understanding of GPCR signaling, and its molecular mechanism is still not well understood. Recently, we have solved the structure of a GPCR-G protein-βarr megacomplex by cryo-electron microscopy. This 'megaplex' structure illustrates the independent and simultaneous coupling of a G protein to the receptor intracellular core, and binding of a βarr to a phosphorylated receptor C-terminal tail, with all three components maintaining their respective canonically active conformations. The structure provides evidence for the ability of a GPCR to activate G protein even while being bound to and internalized by βarr. It also reveals that the binding of G protein and βarr to the same GPCR is not mutually exclusive, and raises a number of future questions to be answered regarding the mechanism of sustained signaling.","affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["article-commentary","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"grantId":"R01 HL016037","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0},{"grantId":"F30HL149213","agency":"National Heart, Lung, and Blood Institute","orderIn":0},{"grantId":"R01HL016037","agency":"National Heart, Lung, and Blood Institute","orderIn":0},{"agency":"Howard Hughes Medical Institute","orderIn":0},{"grantId":"T32 GM145449","agency":"NIGMS NIH HHS","acronym":"GM","orderIn":0},{"grantId":"F30HL149213","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0},{"grantId":"R01HL016037","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0},{"grantId":"F30 HL149213","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Endosomes","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"Y"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"GTP-Binding Proteins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"Y"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Receptors, G-Protein-Coupled","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"Y"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Cryoelectron Microscopy"},{"majorTopic_YN":"N","descriptorName":"Signal Transduction","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Endocytosis","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Molecular Conformation"},{"majorTopic_YN":"N","descriptorName":"Protein Binding","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Phosphorylation"},{"majorTopic_YN":"N","descriptorName":"beta-Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"Y"}]}}]},"keywordList":{"keyword":["Structure","G protein","Cryo-electron microscopy","G protein-coupled receptors","Β-arrestin","Sustained Endosomal Signaling"]},"chemicalList":{"chemical":[{"name":"GTP-Binding Proteins","registryNumber":"EC 3.6.1.-"},{"name":"Receptors, G-Protein-Coupled","registryNumber":"0"},{"name":"Arrestins","registryNumber":"0"},{"name":"beta-Arrestins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1111/febs.15773"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC8252779"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC8252779?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":35,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2021-07-21","dateOfCreation":"2021-02-19","firstIndexDate":"2021-02-20","fullTextReceivedDate":"2025-02-04","dateOfRevision":"2022-10-19","electronicPublicationDate":"2021-03-08","firstPublicationDate":"2021-03-08"},{"id":"36465650","source":"MED","pmid":"36465650","pmcid":"PMC9708903","fullTextIdList":{"fullTextId":["PMC9708903"]},"doi":"10.3389/fendo.2022.1048601","title":"Intracellular VHHs to monitor and modulate GPCR signaling.","authorString":"Raynaud P, Gauthier C, Jugnarain V, Jean-Alphonse F, Reiter E, Bruneau G, Crépieux P.","authorList":{"author":[{"fullName":"Raynaud P","firstName":"Pauline","lastName":"Raynaud","initials":"P","authorId":{"type":"ORCID","value":"0000-0001-7568-9015"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."}]}},{"fullName":"Gauthier C","firstName":"Camille","lastName":"Gauthier","initials":"C","authorId":{"type":"ORCID","value":"0000-0003-2950-7406"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."}]}},{"fullName":"Jugnarain V","firstName":"Vinesh","lastName":"Jugnarain","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."}]}},{"fullName":"Jean-Alphonse F","firstName":"Frédéric","lastName":"Jean-Alphonse","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-7380-5825"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."},{"affiliation":"Inria, Inria Saclay-Ile-de-France, Palaiseau, France."}]}},{"fullName":"Reiter E","firstName":"Eric","lastName":"Reiter","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."},{"affiliation":"Inria, Inria Saclay-Ile-de-France, Palaiseau, France."}]}},{"fullName":"Bruneau G","firstName":"Gilles","lastName":"Bruneau","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."}]}},{"fullName":"Crépieux P","firstName":"Pascale","lastName":"Crépieux","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France."},{"affiliation":"Inria, Inria Saclay-Ile-de-France, Palaiseau, France."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7568-9015"},{"type":"ORCID","value":"0000-0002-7380-5825"},{"type":"ORCID","value":"0000-0003-2950-7406"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"volume":"13","journalIssueId":3311505,"dateOfPublication":"2022 ","monthOfPublication":0,"yearOfPublication":2022,"printPublicationDate":"2022-01-01","journal":{"title":"Frontiers in endocrinology","medlineAbbreviation":"Front Endocrinol (Lausanne)","isoabbreviation":"Front Endocrinol (Lausanne)","essn":"1664-2392","issn":"1664-2392","nlmid":"101555782"}},"pubYear":"2022","pageInfo":"1048601","abstractText":"Single-domain antibody fragments, also known as VHHs or nanobodies, have opened promising avenues in therapeutics and in exploration of intracellular processes. Because of their unique structural properties, they can reach cryptic regions in their cognate antigen. Intracellular VHHs/antibodies primarily directed against cytosolic proteins or transcription factors have been described. In contrast, few of them target membrane proteins and even less recognize G protein-coupled receptors. These receptors are major therapeutic targets, which reflects their involvement in a plethora of physiological responses. Hence, they elicit a tremendous interest in the scientific community and in the industry. Comprehension of their pharmacology has been obscured by their conformational complexity, that has precluded deciphering their structural properties until the early 2010's. To that respect, intracellular VHHs have been instrumental in stabilizing G protein-coupled receptors in active conformations in order to solve their structure, possibly bound to their primary transducers, G proteins or β-arrestins. In contrast, the modulatory properties of VHHs recognizing the intracellular regions of G protein-coupled receptors on the induced signaling network have been poorly studied. In this review, we will present the advances that the intracellular VHHs have permitted in the field of GPCR signaling and trafficking. We will also discuss the methodological hurdles that linger the discovery of modulatory intracellular VHHs directed against GPCRs, as well as the opportunities they open in drug discovery.","affiliation":"Physiologie de la Reproduction et des Comportements (PRC), Institut National de Recherche pour l'Agriculture, l'Alimentation et l'Environnement (INRAE), Centre National de la Recherche Scientifique (CNRS), Institut Français du Cheval et de l'Equitation (IFCE), Université de Tours, Nouzilly, France.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","review-article","Review","Journal Article"]},"grantsList":{"grant":[{"agency":"Conseil Régional du Centre-Val de Loire","orderIn":0},{"agency":"Agence Nationale de la Recherche","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Membrane Proteins"},{"majorTopic_YN":"Y","descriptorName":"Antibodies"},{"majorTopic_YN":"N","descriptorName":"Monitoring, Physiologic"},{"majorTopic_YN":"N","descriptorName":"Signal Transduction"},{"majorTopic_YN":"Y","descriptorName":"Drug Discovery"}]},"keywordList":{"keyword":["Biosensor","G proteins","G protein-coupled receptor","Cell signaling","Β-arrestins","Conformations","Intracellular Vhhs"]},"chemicalList":{"chemical":[{"name":"Membrane Proteins","registryNumber":"0"},{"name":"Antibodies","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Unpaywall","url":"https://www.frontiersin.org/articles/10.3389/fendo.2022.1048601/pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fendo.2022.1048601"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC9708903"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC9708903?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"37923554","source":"MED","reference":"FEBS Lett. 2024 Jan;598(2):220-232. doi: 10.1002/1873-3468.14765","type":"Comment in","orderIn":1}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":10,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2022-12-06","dateOfCreation":"2022-12-05","firstIndexDate":"2022-12-06","fullTextReceivedDate":"2022-12-02","dateOfRevision":"2024-02-06","electronicPublicationDate":"2022-11-16","firstPublicationDate":"2022-11-16"},{"id":"37844230","source":"MED","pmid":"37844230","pmcid":"PMC10614829","fullTextIdList":{"fullTextId":["PMC10614829"]},"doi":"10.1073/pnas.2303794120","title":"Signal transduction at GPCRs: Allosteric activation of the ERK MAPK by β-arrestin.","authorString":"Kahsai AW, Shah KS, Shim PJ, Lee MA, Shreiber BN, Schwalb AM, Zhang X, Kwon HY, Huang LY, Soderblom EJ, Ahn S, Lefkowitz RJ.","authorList":{"author":[{"fullName":"Kahsai AW","firstName":"Alem W","lastName":"Kahsai","initials":"AW","authorId":{"type":"ORCID","value":"0000-0001-9272-4484"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Shah KS","firstName":"Kunal S","lastName":"Shah","initials":"KS","authorId":{"type":"ORCID","value":"0000-0001-9906-3025"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Duke University School of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Shim PJ","firstName":"Paul J","lastName":"Shim","initials":"PJ","authorId":{"type":"ORCID","value":"0000-0002-6610-8378"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Department of Medicine, College of Medicine, The University of Arizona, Phoenix, AZ 85004."}]}},{"fullName":"Lee MA","firstName":"Mason A","lastName":"Lee","initials":"MA","authorId":{"type":"ORCID","value":"0000-0001-8772-3567"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Shreiber BN","firstName":"Bowie N","lastName":"Shreiber","initials":"BN","authorId":{"type":"ORCID","value":"0000-0003-3134-4431"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Schwalb AM","firstName":"Allison M","lastName":"Schwalb","initials":"AM","authorId":{"type":"ORCID","value":"0000-0002-1905-8988"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Duke University School of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Zhang X","firstName":"Xingdong","lastName":"Zhang","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Kwon HY","firstName":"Henry Y","lastName":"Kwon","initials":"HY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"General Surgery Residency Program, Henry Ford Hospital, Detroit, MI 48202."}]}},{"fullName":"Huang LY","firstName":"Li-Yin","lastName":"Huang","initials":"LY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Soderblom EJ","firstName":"Erik J","lastName":"Soderblom","initials":"EJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cell Biology, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Duke Center for Genomic and Computational Biology, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Ahn S","firstName":"Seungkirl","lastName":"Ahn","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-5681-3789"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."}]}},{"fullName":"Lefkowitz RJ","firstName":"Robert J","lastName":"Lefkowitz","initials":"RJ","authorId":{"type":"ORCID","value":"0000-0003-1472-7545"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Department of Biochemistry, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"Department of Chemistry, Duke University Medical Center, Durham, NC 27710."},{"affiliation":"HHMI, Duke University Medical Center, Durham, NC 27710."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5681-3789"},{"type":"ORCID","value":"0000-0001-8772-3567"},{"type":"ORCID","value":"0000-0001-9272-4484"},{"type":"ORCID","value":"0000-0001-9906-3025"},{"type":"ORCID","value":"0000-0002-1905-8988"},{"type":"ORCID","value":"0000-0002-6610-8378"},{"type":"ORCID","value":"0000-0003-1472-7545"},{"type":"ORCID","value":"0000-0003-3134-4431"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data","plain_english"]},"journalInfo":{"issue":"43","volume":"120","journalIssueId":3647300,"dateOfPublication":"2023 Oct","monthOfPublication":10,"yearOfPublication":2023,"printPublicationDate":"2023-10-01","journal":{"title":"Proceedings of the National Academy of Sciences of the United States of America","medlineAbbreviation":"Proc Natl Acad Sci U S A","isoabbreviation":"Proc Natl Acad Sci U S A","essn":"1091-6490","issn":"0027-8424","nlmid":"7505876"}},"pubYear":"2023","pageInfo":"e2303794120","abstractText":"β-arrestins are multivalent adaptor proteins that bind active phosphorylated G protein-coupled receptors (GPCRs) to inhibit G protein signaling, mediate receptor internalization, and initiate alternative signaling events. β-arrestins link agonist-stimulated GPCRs to downstream signaling partners, such as the c-Raf-MEK1-ERK1/2 cascade leading to ERK1/2 activation. β-arrestins have been thought to transduce signals solely via passive scaffolding by facilitating the assembly of multiprotein signaling complexes. Recently, however, β-arrestin 1 and 2 were shown to activate two downstream signaling effectors, c-Src and c-Raf, allosterically. Over the last two decades, ERK1/2 have been the most intensely studied signaling proteins scaffolded by β-arrestins. Here, we demonstrate that β-arrestins play an active role in allosterically modulating ERK kinase activity in vitro and within intact cells. Specifically, we show that β-arrestins and their GPCR-mediated active states allosterically enhance ERK2 autophosphorylation and phosphorylation of a downstream ERK2 substrate, and we elucidate the mechanism by which β-arrestins do so. Furthermore, we find that allosteric stimulation of dually phosphorylated ERK2 by active-state β-arrestin 2 is more robust than by active-state β-arrestin 1, highlighting differential capacities of β-arrestin isoforms to regulate effector signaling pathways downstream of GPCRs. In summary, our study provides strong evidence for a new paradigm in which β-arrestins function as active \"catalytic\" scaffolds to allosterically unlock the enzymatic activity of signaling components downstream of GPCR activation.","affiliation":"Department of Medicine, Duke University Medical Center, Durham, NC 27710.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"grantId":"R01 HL016037","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0},{"grantId":"T32 HL007101","agency":"NHLBI NIH HHS","acronym":"HL","orderIn":0},{"agency":"Howard Hughes Medical Institute","acronym":"HHMI","orderIn":0},{"grantId":"HL16037","agency":"HHS | NIH | National Heart, Lung, and Blood Institute","orderIn":0},{"grantId":"HL16037-45S1","agency":"HHS | NIH | National Heart, Lung, and Blood Institute","orderIn":0},{"grantId":"HHMI","agency":"Howard Hughes Medical Institute","orderIn":0},{"grantId":"T32HL007101","agency":"HHS | NIH | National Heart, Lung, and Blood Institute","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"Y","descriptorName":"Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Receptors, G-Protein-Coupled","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Signal Transduction","meshQualifierList":{"meshQualifier":[{"abbreviation":"PH","qualifierName":"physiology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Allosteric Regulation"},{"majorTopic_YN":"N","descriptorName":"Phosphorylation"},{"majorTopic_YN":"N","descriptorName":"beta-Arrestins","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"beta-Arrestin 1","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"beta-Arrestin 2","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}}]},"keywordList":{"keyword":["Signal transduction","Erk Mapk","Scaffold Proteins","Β-arrestin","Catalytic Scaffolds"]},"chemicalList":{"chemical":[{"name":"Receptors, G-Protein-Coupled","registryNumber":"0"},{"name":"Arrestins","registryNumber":"0"},{"name":"beta-Arrestins","registryNumber":"0"},{"name":"beta-Arrestin 1","registryNumber":"0"},{"name":"beta-Arrestin 2","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"doi","site":"Unpaywall","url":"https://doi.org/10.1073/pnas.2303794120"},{"availability":"Subscription required","availabilityCode":