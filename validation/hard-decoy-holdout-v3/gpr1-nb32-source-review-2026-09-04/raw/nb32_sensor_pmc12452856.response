<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="research-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">2</journal-id><journal-id journal-id-type="pmc-domain">pnas</journal-id><journal-title-group><journal-title>Proceedings of the National Academy of Sciences of the United States of America</journal-title><abbrev-journal-title>Proc Natl Acad Sci U S A</abbrev-journal-title></journal-title-group><publisher><publisher-name>National Academy of Sciences</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC12452856</article-id><article-id pub-id-type="pmcaid">12452856</article-id><article-id pub-id-type="pmcaiid">12452856</article-id><article-id pub-id-type="pmid">40924451</article-id><article-id pub-id-type="doi">10.1073/pnas.2507384122</article-id><title-group><article-title>A genetically encoded nanobody sensor reveals conformational diversity in β-arrestins orchestrated by distinct seven transmembrane receptors</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Sarma</surname><given-names initials="P">Parishmita</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref rid="fn2" ref-type="author-notes">1</xref></contrib><contrib><name name-style="western"><surname>Nagy Marková</surname><given-names initials="V">Vendula</given-names></name><xref ref-type="aff" rid="aff2">b</xref><xref ref-type="aff" rid="aff3">c</xref><xref ref-type="aff" rid="aff4">d</xref><xref rid="fn2" ref-type="author-notes">1</xref></contrib><contrib><name name-style="western"><surname>Dalal</surname><given-names initials="A">Annu</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Mishra</surname><given-names initials="S">Sudha</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Zaidi</surname><given-names initials="N">Nashrah</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Tiwari</surname><given-names initials="D">Divyanshu</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Yadav</surname><given-names initials="MK">Manish K</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Roy</surname><given-names initials="N">Nabarun</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Mahajan</surname><given-names initials="G">Gargi</given-names></name><xref ref-type="aff" rid="aff1">a</xref></contrib><contrib><name name-style="western"><surname>Miclea</surname><given-names initials="P">Paul</given-names></name><xref ref-type="aff" rid="aff2">b</xref><xref ref-type="aff" rid="aff3">c</xref></contrib><contrib><name name-style="western"><surname>Lazar</surname><given-names initials="J">Josef</given-names></name><xref ref-type="aff" rid="aff2">b</xref><xref ref-type="aff" rid="aff3">c</xref><xref rid="cor1" ref-type="author-notes">2</xref></contrib><contrib><name name-style="western"><surname>Shukla</surname><given-names initials="AK">Arun K</given-names></name><xref ref-type="aff" rid="aff1">a</xref><xref rid="cor1" ref-type="author-notes">2</xref></contrib></contrib-group><aff id="aff1"><label>a</label>Department of Biological Sciences and Bioengineering, Indian Institute of Technology, Kanpur
208016, India</aff><aff id="aff2"><label>b</label>First Faculty of Medicine, Charles University in Prague, Prague
121 08, Czech Republic</aff><aff id="aff3"><label>c</label>Institute of Organic Chemistry and Biochemistry Czech Academy of Sciences, Prague
160 00, Czech Republic</aff><aff id="aff4"><label>d</label>Faculty of Science, Charles University in Prague, Prague
128 00, Czech Republic</aff><author-notes><fn id="cor1"><label>2</label><p>To whom correspondence may be addressed. Email: <email>josef.lazar@lf1.cuni.cz</email> or <email>arshukla@iitk.ac.in</email>.</p></fn><fn id="fn1"><p>Edited by J. Silvio Gutkind, University of California San Diego Medical Center, La Jolla, CA; received March 29, 2025; accepted July 30, 2025 by Editorial Board Member Krzysztof Palczewski</p></fn><fn id="fn2"><p><sup>1</sup>P.S. and V.N.M. contributed equally to this work.</p></fn></author-notes><pub-date><day>9</day><month>9</month><year>2025</year></pub-date><volume>122</volume><issue>37</issue><fpage>e2507384122</fpage><page-range>e2507384122</page-range><pub-history><event event-type="pmc-release"><date><day>9</day><month>3</month><year>2026</year></date></event></pub-history><permissions><copyright-statement>Copyright © 2025 the Author(s). Published by PNAS.</copyright-statement><license><license-p>This article is distributed under <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/" ext-link-type="uri">Creative Commons Attribution-NonCommercial-NoDerivatives License 4.0 (CC BY-NC-ND)</ext-link>.</license-p></license></permissions><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="pnas.202507384.pdf" content-type="pmc-pdf"><?cloudpmc-path cb6a/12452856/6ae0c02dc9df/pnas.202507384.pdf?><?cloudpmc-bucket app?><?size 5244567?></self-uri><abstract id="abstract1" abstract-type="executive-summary"><title>Significance</title><p>G protein–coupled receptors (GPCRs) constitute a family of integral membrane proteins that are involved in numerous physiological and pathophysiological processes in the human body, and they continue to serve as one of the most important classes of drug targets. GPCR signaling is critically regulated at the levels of desensitization and endocytosis by β-arrestins, which are multifunctional adaptor proteins. In this study, we have designed and validated a nanobody-based biosensor that monitors the activation of β-arrestins upon their interaction with selected GPCRs in cellular context. Our findings underscore the inherent flexibility and conformational diversity of β-arrestins imparted by their interaction with different 7TMRs, which presumably underlies their ability to desensitize and regulate a broad repertoire of receptors.</p><sec id="kwd-group1" sec-type="kwd-group" disp-level="2"><p><bold>Keywords:</bold> GPCRs, β-arrestins, nanobodies, intrabodies, polarization microscopy</p></sec></abstract><abstract id="abstract2"><title>Abstract</title><p>Agonist-induced interaction of G protein–coupled receptors (GPCRs) with β-arrestins (βarrs) is a critical mechanism that regulates the spatiotemporal pattern of receptor localization and signaling. While the underlying mechanism governing GPCR–βarr interaction is primarily conserved and involves receptor activation and phosphorylation, there are several examples of receptor-specific fine-tuning of βarr-mediated functional outcomes. Considering the key contribution of conformational plasticity of βarrs in driving receptor-specific functional responses, it is important to develop novel sensors capable of reporting distinct βarr conformations in cellular context. Here, we design an intrabody version of a βarr-recognizing nanobody (nanobody32), referred to as intrabody32 (Ib32), in NanoLuc enzyme complementation assay format and measure its ability to recognize βarr1 and 2 in live cells upon activation of a broad set of GPCRs. Ib32 robustly recognizes activated βarr1 and 2 in the plasma membrane and endosomes, and effectively mirrors βarr recruitment profile upon stimulation of selected GPCRs. We also design an Ib32 sensor for polarization microscopy with a change in linear dichroism as readout and demonstrate its utility for monitoring βarr activation upon stimulation of selected GPCRs by natural and biased agonists. Taken together with a previously described sensor of βarr1 activation, Ib32 underscores the inherent flexibility encoded in βarrs and conformational diversity imparted by different GPCRs, which is further corroborated using an orthogonal limited proteolysis assay. Our study presents Ib32 as a sensor of βarr activation and highlights the structural diversity of βarrs, which likely allows their ability to interact with, and regulate, a large repertoire of GPCRs.</p></abstract><custom-meta-group><custom-meta><meta-name>status</meta-name><meta-value>released</meta-value></custom-meta><custom-meta><meta-name>display-pdf</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>is-olf</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-manuscript</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-preprint</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-journal-matter</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-scanned</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-retracted</meta-name><meta-value>no</meta-value></custom-meta></custom-meta-group></article-meta><notes notes-type="article-notes"><sec id="historyarticle-meta1" sec-type="history" disp-level="2"><p>Received 2025 Mar 29; Accepted 2025 Jul 30; Issue date 2025 Sep 16.</p></sec></notes></front><body><p>G protein–coupled receptors (GPCRs), also referred to as seven transmembrane receptors (7TMRs), represent a large class of cell surface receptors and an important family of drug targets in the human genome (<xref rid="r1" ref-type="bibr">1</xref>–<xref rid="r3" ref-type="bibr">3</xref>). Agonist-induced activation and phosphorylation of GPCRs leads to binding of β-arrestins (βarrs), which is a critical step in regulating receptor signaling and trafficking (<xref rid="r4" ref-type="bibr">4</xref>–<xref rid="r7" ref-type="bibr">7</xref>). Interaction with GPCRs imparts an active conformation on βarrs that is manifested in the form of a significant interdomain rotation between the N- and the C-domains, and the rearrangement of multiple loops in βarrs (<xref rid="r8" ref-type="bibr">8</xref>–<xref rid="r14" ref-type="bibr">14</xref>). As the paradigm of agonist-induced βarr recruitment is typically conserved across nearly the entire repertoire of GPCRs, monitoring βarr activation may serve as a readout of receptor activation and the ensuing downstream signaling. A number of biosensors of βarrs based on BRET and FRET have been designed and used to monitor activation-dependent conformational changes in βarrs previously (<xref rid="r15" ref-type="bibr">15</xref>–<xref rid="r20" ref-type="bibr">20</xref>). While some of these are capable of illuminating receptor-specific conformational signatures in βarrs, considering the ever-expanding layers of structural and functional complexities encoded in the GPCR–βarr system, additional biosensors amenable to cellular studies with easily accessible experimental set-up are still highly desirable.</p><p>Nanobodies have emerged as powerful tools in recent years to probe various aspects of GPCR activation and signaling, not only as conformational stabilizing chaperones for structural analyses but also as robust sensors for monitoring receptor activation (<xref rid="r21" ref-type="bibr">21</xref>–<xref rid="r24" ref-type="bibr">24</xref>). In addition, several nanobodies targeting heterotrimeric G-proteins, originally described for structural investigation, have been successfully adopted to reveal novel aspects of spatiotemporal signaling and regulatory paradigms of GPCRs (<xref rid="r24" ref-type="bibr">24</xref>). However, the use of intrabody sensors in the context of GPCR–βarrs is rather limited with only very few published examples (<xref rid="r20" ref-type="bibr">20</xref>, <xref rid="r25" ref-type="bibr">25</xref>, <xref rid="r26" ref-type="bibr">26</xref>). Intrabody30 (Ib30), an intrabody derived from a synthetic antibody fragment (Fab30), has been developed and characterized to monitor agonist-induced GPCR–βarr1 interaction and trafficking in cellular context using confocal microscopy and NanoLuc enzyme complementation-based assay (<xref rid="r20" ref-type="bibr">20</xref>, <xref rid="r27" ref-type="bibr">27</xref>). Immunization of <italic>Lama glama</italic> with a preformed complex consisting of βarr1 and a chimeric β2-adrenergic receptor (β2V2R), and subsequent <italic>in-vitro</italic> screening, yielded several nanobodies that selectively recognize activated conformation of βarr1 (<xref rid="r28" ref-type="bibr">28</xref>). One of these nanobodies, referred to as Nb32, was characterized in detail, first, in terms of promoting the formation of a fully engaged β2V2R–βarr1 complex (<xref rid="r28" ref-type="bibr">28</xref>) and then to visualize a β2V2R–G-protein–βarr1 endosomal signaling complex (<xref rid="r29" ref-type="bibr">29</xref>). Considering the ability of Nb32 to selectively recognize activated βarr1, it represents a potential candidate to develop as an intrabody sensor of βarr activation in cellular context.</p><p>In this backdrop, here we describe a Nb32-based biosensor, referred to as intrabody32 (Ib32), in a NanoLuc/NanoBiT-based enzyme complementation format that is capable of reporting GPCR-induced activation of both isoforms of βarrs, i.e., βarr1 and 2 by multiple GPCRs. When used in conjunction with a previously described Ib30 biosensor, Ib32 uncovers distinct conformations of βarrs induced by different GPCRs. We also design Ib32 sensors suitable for polarization microscopy with activation-dependent change in linear dichroism (LD) as readout and validate them on multiple GPCRs using balanced and biased agonists. Collectively, Ib32-based sensors described here underscore the conformational diversity in GPCR–βarrs, and they may be useful tools for delineating previously unexplored complexities of GPCR signaling and regulation.</p><sec id="s1" disp-level="1"><title>Results</title><sec id="s2" disp-level="2"><title>Construct Design and Validation of Ib32 Biosensor.</title><p>Nb32 was identified to bind and stabilize the β2V2R–βarr1 complex (<xref rid="r28" ref-type="bibr">28</xref>) and subsequently used to determine the structure of the β2V2R–G-protein–βarr1 endosomal signaling complex (<xref rid="r29" ref-type="bibr">29</xref>). Nb32 binds to the N-domain of βarr1 in an active conformation, while it does not recognize the basal conformation of βarr1 (<xref rid="r28" ref-type="bibr">28</xref>, <xref rid="r29" ref-type="bibr">29</xref>) (<xref rid="fig01" ref-type="fig">Fig. 1<italic>A</italic></xref>), and therefore, it has the potential to be developed as a sensor of βarr activation. We retrieved the sequence of Nb32 from the previously determined structure and generated a set of constructs with N- and C-terminal fusion of the large and small fragments of the NanoLuc enzyme (i.e., LgBiT and SmBiT) following the principles of enzyme complementation assay (<xref rid="fig01" ref-type="fig">Fig. 1<italic>B</italic></xref>). These constructs are referred to as Ib32 (intrabody 32) as they are designed to express the Nb32 as a cytoplasmic protein. In order to validate and identify the optimal constructs, we performed enzyme complementation assay with each of these constructs in combination with the corresponding βarr1/2 versions described previously (<xref rid="r27" ref-type="bibr">27</xref>) and the vasopressin receptor (V2R), a prototypical GPCR as a model system. We observed that a combination of LgBiT–Ib32 and SmBiT–βarr1 yielded maximal luminescence signal upon agonist-stimulation although other combinations also exhibited measurable signal (<xref rid="fig01" ref-type="fig">Fig. 1<italic>C</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S1 <italic>A</italic> and <italic>C</italic></ext-link>). A similar combination also worked with βarr2, although luminescence signal was relatively smaller than with βarr1 (<xref rid="fig01" ref-type="fig">Fig. 1<italic>D</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S1 <italic>B</italic> and <italic>D</italic></ext-link>). We also note that the basal signal for βarr2 was relatively higher than βarr1 for some of the construct combinations in some experiments (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S1 <italic>A</italic>−<italic>D</italic></ext-link>), and this may also impact the normalized fold response observed in this assay. In order to further corroborate these findings, we measured the dose–response of agonist-stimulation. We observed a saturating response with increasing concentration of agonists with an EC<sub>50</sub> value commensurate with that of βarr recruitment to V2R (<xref rid="r20" ref-type="bibr">20</xref>) (<xref rid="fig01" ref-type="fig">Fig. 1<italic>E</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S1<italic>E</italic></ext-link>). Surface expression of the V2R in these experiments as measured using a previously described whole-cell ELISA is presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S1 <italic>F</italic>−<italic>I</italic></ext-link>. In order to directly visualize the Interaction of Ib32 with βarrs upon activation of V2R, we carried out coimmunoprecipitation experiments by pulling down either HA-Ib32 or Flag-V2R, and we observed a robust interaction of Ib32 with βarrs under agonist stimulation conditions (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S2 <italic>A</italic> and <italic>B</italic></ext-link>). Similar to the NanoBiT assay described above, we observed slightly higher basal interaction between Ib32 and βarr2 compared to βarr1 in some experiments. Taken together, these data establish the ability of Ib32 to recognize activated conformations of both βarr isoforms (i.e. βarr1 and 2) in cellular context although their relative responses differ from each other.</p><fig id="fig01" position="float"><?disp-level 3?><label>Fig. 1.</label><caption><p>Construct design and validation of Ib32 as a sensor of βarr activation. (<italic>A</italic>) Structural snapshot representing the binding interface of Nb32 on the N-domain of V2Rpp-bound βarr1 (designed using PDB ID: 6NI2). (<italic>B</italic>) Schematic depiction of SmBiT/LgBiT-tagged Ib32 and βarr constructs to identify the optimal combination for the NanoBiT assay. (<italic>C</italic> and <italic>D</italic>) Representation of the Ib32 reactivity data as a heat map for various combinations of the Ib32 and βarr1/2 constructs in response to agonist-stimulation of V2R (mean of three independent experiments, fold normalized with respect to unstimulated condition treated as 1). (<italic>E</italic>) Dose–response curve of Ib32 reactivity for βarr1/2 upon stimulation of V2R with increasing concentrations of AVP (mean±SEM, n = 4, fold normalized with respect to the response at the lowest ligand concentration treated as 1).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig01.jpg"><?cloudpmc-path blobs/cb6a/12452856/acac774e8427/pnas.2507384122fig01.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1391?><?original-width 2207?><?scaled-height 463?><?scaled-width 735?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig01.gif"><?cloudpmc-path blobs/cb6a/12452856/7d1966597c90/pnas.2507384122fig01.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="s3" disp-level="2"><title>Ib32 As a Sensor of βarr Activation for Multiple GPCRs.</title><p>Next, we tested the Ib32 sensor on a diverse set of GPCRs including complement and chemokine receptors, the bradykinin B2 receptor, angiotensin II type 1 receptor, muscarinic M2 receptor, kisspeptin receptor, motilin receptor, and the niacin receptor (GPR109A). We selected these receptors based on their relative propensities to interact with βarrs and binding modalities. For example, most of these receptors can be categorized as class A vs. B receptors based on stability of their interaction (<xref rid="r30" ref-type="bibr">30</xref>) (class A: CXCR1, CXCR2, CXCR3, CXCR4, GPR109A; class B: C5aR1, AT1R, B2R), and they contain potential phosphorylation sites primarily in their carboxyl-terminus. In contrast, the muscarinic receptor subtype 2 (M2R) interacts with βarrs primarily through the 3rd intracellular loop instead of the carboxyl-terminus (M2R)<sup>13</sup>. Three of the selected receptors namely the complement receptor C5aR2, atypical chemokine receptor 2, ACKR2 (a.k.a. decoy D6 receptor), and atypical chemokine receptor 3, ACKR3 (a.k.a. chemokine receptor CXCR7) (<xref rid="r31" ref-type="bibr">31</xref>), are arrestin-coupled receptors (ACRs), which lack functional G-protein-coupling but robustly interact with βarrs (<xref rid="r31" ref-type="bibr">31</xref>–<xref rid="r33" ref-type="bibr">33</xref>).</p><p>We observed a robust response for the AT1R and B2R, while a modest response for the D6R and CXCR2 is presented in <xref rid="fig02" ref-type="fig">Fig. 2 <italic>A</italic> and <italic>B</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S3 <italic>A</italic>−<italic>D</italic></ext-link>. Next, we measured the dose–response of agonist stimulation for the AT1R and B2R and observed saturating responses with increasing agonist concentrations (<xref rid="fig02" ref-type="fig">Fig. 2 <italic>C</italic> and <italic>D</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S3 <italic>E</italic> and <italic>F</italic></ext-link>). The observed EC<sub>50</sub> values in the dose–response assay correspond well with that of βarr recruitment for these receptors reported previously. The surface expression levels of the receptors tested here are presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S3 <italic>G</italic>−<italic>N</italic></ext-link>. As mentioned earlier, it is possible that the response window for different receptors may also depend on the construct combinations (i.e., position of the SmBiT and LgBiT) used in these assays. Therefore, we tested all the NanoBiT constructs for three different receptors, namely the C5aR1, C5aR2, and CXCR2. We observed that there were modest differences in the response window among various construct combinations, especially for the C5aR1, but the overall pattern did not change dramatically (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Figs. S4 <italic>A</italic>−<italic>C</italic> and S5 <italic>A</italic>−<italic>L</italic></ext-link>). The surface expression of the receptors under these experimental conditions are presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S4 <italic>D</italic>−<italic>F</italic></ext-link>. We also note that different receptors exhibit a variation in their relative surface expression, and therefore, it is plausible that a case-by-case optimization of the expression levels of individual receptors may allow a larger response window even for those receptors, which do not appear to respond strongly in the screening panel presented in <xref rid="fig02" ref-type="fig">Fig. 2 <italic>A</italic> and <italic>B</italic></xref>. Similar to V2R, we observed a relatively smaller response for βarr2 compared to βarr1 for multiple receptors tested here, and this may indicate a lower affinity of Ib32 for βarr2.</p><fig id="fig02" position="float"><?disp-level 3?><label>Fig. 2.</label><caption><p>Ib32 as a sensor of βarr activation for multiple 7TMRs. (<italic>A</italic> and <italic>B</italic>) Representation of the Ib32 reactivity data using the NanoBiT assay presented as a heat map for indicated receptors in response to respective agonist-stimulation (mean of three independent experiments, fold normalized with respect to unstimulated condition treated as 1). (<italic>C</italic> and <italic>D</italic>) Dose–response curve for Ib32 reactivity upon stimulation of B2R and AT1R with increasing concentrations of bradykinin (BK) and angiotensin II (AngII), respectively (mean±SEM, n = 4, fold normalized with respect to the unstimulated condition treated as 1).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig02.jpg"><?cloudpmc-path blobs/cb6a/12452856/ec0f6d266436/pnas.2507384122fig02.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1825?><?original-width 1858?><?scaled-height 730?><?scaled-width 743?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig02.gif"><?cloudpmc-path blobs/cb6a/12452856/e1124df7e972/pnas.2507384122fig02.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="s4" disp-level="2"><title>Ib32 Sensor for Fluorescence-Based Linear Dichroism Microscopy.</title><p>In order to broaden the application of Ib32 sensors for monitoring βarr activation in live cells, we designed a construct, referred to as Ib32-mEGFP-H-Ras, consisting of Ib32 with carboxyl-terminus fusion to a monomeric enhanced green fluorescent protein (mEGFP) and a membrane-targeting isoprenylation signal peptide derived from H-Ras (<xref rid="fig03" ref-type="fig">Fig. 3<italic>A</italic></xref>). The design aims to exploit intrinsic optical anisotropy of fluorescent proteins (<xref rid="r34" ref-type="bibr">34</xref>) in order to detect and characterize GPCR–βarr interactions. Briefly, fluorescent proteins anchored to the cell membrane often exhibit light absorption rates (and therefore fluorescence intensities) dependent on the direction of the linear polarization of the excitation light. This phenomenon, termed linear dichroism (LD), can be used to observe changes in orientation of a fluorescent moiety with respect to the cell membrane (<xref rid="r35" ref-type="bibr">35</xref>). As a result, a change LD in a fluorescently tagged molecule may provide an indication of a conformational change or a protein–protein interaction (<xref rid="r35" ref-type="bibr">35</xref>).</p><fig id="fig03" position="float"><?disp-level 3?><label>Fig. 3.</label><caption><p>Ib32 reactivity readout using linear dichroism microscopy. (<italic>A</italic>) Schematic representation of the mechanism of response of the Ib32-mEGFP-H-Ras sensor. Binding of Ib32 to a GPCR–βarr leads to a change in orientation of the eGFP moiety with respect to the cell membrane, resulting in a change in linear dichroism. (<italic>B</italic>−<italic>E</italic>) Agonist-induced changes in the linear dichroism of Ib32-mEGFP-H-Ras upon stimulation of V2R and B2R by AVP and bradykinin, respectively. The plots showing the extent of linear dichroism {quantified as log<sub>2</sub>(r<sub>max</sub>)}, on Ib32-mEGFP-H-Ras, binding with βarr1/2 downstream of the ligand-induced V2R, and B2R before stimulation (0 min) and after stimulation (5 and 15 min). Each data point represents a single cell and mean with 95% CI are indicated with statistical analysis using a paired <italic>t</italic> test (*<italic>P</italic> &lt; 0.05; **&lt;0.01; ***<italic>P</italic> &lt; 0.001).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig03.jpg"><?cloudpmc-path blobs/cb6a/12452856/86fc10481a94/pnas.2507384122fig03.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 3116?><?original-width 2180?><?scaled-height 1038?><?scaled-width 726?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig03.gif"><?cloudpmc-path blobs/cb6a/12452856/79af394a3773/pnas.2507384122fig03.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><p>We tested the Ib32-mEGFP-H-Ras sensor on cells overexpressing the V2R or B2R, and βarr1/2-mCherry constructs to monitor the expression of βarrs in the cells used for LD measurements. We observed that receptor stimulation resulted in a robust increase in LD for both βarr isoforms (<xref rid="fig03" ref-type="fig">Fig. 3 <italic>B</italic>−<italic>E</italic></xref>). Similar to NanoBiT complementation assay, the Ib32-mEGFP-H-Ras sensor exhibited a relatively larger change for βarr1 than βarr2 (<xref rid="fig03" ref-type="fig">Fig. 3 <italic>B</italic>−<italic>E</italic></xref>). Although we observed a relatively higher baseline signal for βarr2 than βarr1 (i.e., prior to agonist-stimulation), the differences were not statistically significant. Interestingly, even in the absence of an overexpressed GPCR, βarr2 showed somewhat higher baseline response than βarr1, which may indicate a higher interaction of Ib32 biosensor with the basal conformation of βarr2 compared to βarr1. We also note that our polarization microscopy data are quantitated in absolute terms of LD, i.e., dichroic log ratio log<sub>2</sub>(r<sub>rmax</sub>), instead of fold-response over basal as in the NanoBiT complementation assay. Thus, the baseline signals are not likely to impact the responses observed here. The different magnitudes of responses to βarr1 and βarr2 activation in Ib32-mEGFP-H-Ras, observed at saturating agonist concentrations, likely reflect differences in GPCR-induced conformational changes between the two βarr isoforms, with βarr2 activation being reported with lower sensitivity. As a negative control, we also measured agonist-induced changes in LD in cells expressing either Ib32, Ib32+βarr1/2, or Ib32+receptor, however, none of these conditions elicited a measurable response (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S6 <italic>A</italic>−<italic>D</italic></ext-link>). Taken together, these observations establish the agonist-induced and GPCR-mediated response measured in this assay. It is also important to note that the observed variability of responses among cells likely arises from the differences in the expression levels of various components and focused optimization in future studies may yield an improved response window. We also acknowledge that carboxyl-terminus fusion of fluorescent proteins to βarrs is commonly used in the literature to monitor their interaction with GPCRs and subcellular localization. Still, however, we cannot rule out the possibility that such a construct may have an impact on the overall conformation of βarrs, for example, by releasing the autoinhibition to some extent, and thereby, influencing the extent of Ib32 reactivity even under the basal condition.</p></sec><sec id="s5" disp-level="2"><title>Ib32 Reactivity Reports Ligand Pharmacology and Compartmentalization of βarrs.</title><p>Next, we tested the ability of Ib32 sensor to recognize βarr conformation upon stimulation of AT1R by a βarr-biased agonist, TRV027, vis-à-vis AngII, and we also measured βarr recruitment using a direct interaction assay based on the NanoBiT approach. We observed that TRV027 was relatively weaker in eliciting βarr recruitment compared to AngII (<xref rid="fig04" ref-type="fig">Fig. 4 <italic>A</italic> and <italic>C</italic></xref>), and accordingly, Ib32 sensor mirrors the βarr recruitment pattern (<xref rid="fig04" ref-type="fig">Fig. 4 <italic>B</italic> and <italic>D</italic></xref>). We did not observe a large difference between the basal signal for βarr1 vs. βarr2, either in the recruitment assay or Ib32 reactivity (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S7 <italic>A</italic>−<italic>D</italic></ext-link>). The surface expression of the AT1R in these experiments are presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S7 <italic>E</italic>−<italic>H</italic></ext-link>, which confirms substantial receptor expression compared to mock-transfected cells. In the linear dichroism assay using polarization microscopy, we observed a rather modest but statistically significant response upon stimulation with TRV027, especially at 5 min poststimulation, compared to AngII stimulation (<xref rid="fig04" ref-type="fig">Fig. 4 <italic>E</italic>−<italic>H</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S8 <italic>A</italic>−<italic>D</italic></ext-link>). A direct comparison of the change in LD for βarr1 vs. βarr2 under basal and agonist-induced conditions exhibited minor differences for different receptors, although a consistent pattern did not emerge (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S9 <italic>A−D</italic></ext-link>). In the enzyme complementation assay, we likely observe a combination of βarr activation at the plasma membrane and endosomal compartment, and this is perhaps also reflected in the linear dichroism experiments for some receptors where the signal at the membrane tethered Ib32 sensor tends to decrease slightly at 15-min time-point of agonist-stimulation. Therefore, we next attempted to test whether Ib32 preferentially recognizes βarrs at one of these subcellular locations, i.e., plasma membrane vs. endosomes. Here, we used either a plasma membrane-tethered LgBiT-CAAX or endosomal localized FYVE-SmBiT construct and measured agonist-induced response. As presented in <xref rid="fig05" ref-type="fig">Fig. 5 <italic>A</italic>−<italic>D</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S10 <italic>A</italic>−<italic>D</italic></ext-link>, we observed robust Ib32 reactivity in both cases; however, the fold response was higher in endosomal compartment than at the plasma membrane. The surface expression of the receptors under these experimental conditions are presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S10 <italic>E</italic>−<italic>L</italic></ext-link>, which confirms substantial receptor expression compared to mock-transfected cells. Expectedly, the time-kinetics of Ib32 reactivity was relatively apparently faster at the plasma membrane compared to the endosomes (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S10 <italic>M</italic>−<italic>P</italic></ext-link>) as anticipated based on agonist-induced receptor endocytosis. However, it remains to be determined whether the higher signal in the endosomal compartment reflects a distinct conformation of βarrs compared to the plasma membrane, or accumulation of internalized βarrs in the endosomes over time of experimental measurement. Alternatively, it is also possible that the V2R is predominantly expressed at the plasma membrane under experimental conditions and, therefore, the basal interaction between Ib32 and βarrs is more prevalent there, leading to a smaller fold response. On the other hand, agonist-stimulation drives V2R to the endosomes through internalization where the basal interaction may be rather small resulting in a higher fold response. It is also interesting to note that in the case of V2R, Ib32 reactivity for βarr1 and 2 is similar at the plasma membrane but relatively stronger for βarr1 in the endosomal compartment, and future studies are warranted to explore this further.</p><fig id="fig04" position="float"><?disp-level 3?><label>Fig. 4.</label><caption><p>Ib32 sensor response aligns with ligand pharmacology. (<italic>A</italic>−<italic>D</italic>) Dose–response curves of βarr1/2 recruitment and Ib32 reactivity upon stimulation of AT1R with its endogenous agonist, angiotensin II (AngII) and a βarr-biased agonist, TRV027 (mean±SEM, n = 4, fold normalized with respect to the response at the lowest agonist concentration treated as 1. (<italic>E−H</italic>) Agonist-induced changes in the linear dichroism of Ib32-mEGFP-H-Ras upon 5- and 15-min poststimulation of AT1R by AngII and TRV027. Each data point represents a single cell and mean with 95% CI are indicated with statistical analysis using a paired <italic>t</italic> test (*<italic>P</italic> &lt; 0.05; **&lt;0.01; ***<italic>P</italic> &lt; 0.001).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig04.jpg"><?cloudpmc-path blobs/cb6a/12452856/2408b9645f94/pnas.2507384122fig04.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 3180?><?original-width 2033?><?scaled-height 1059?><?scaled-width 677?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig04.gif"><?cloudpmc-path blobs/cb6a/12452856/fad528f1a603/pnas.2507384122fig04.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><fig id="fig05" position="float"><?disp-level 3?><label>Fig. 5.</label><caption><p>Ib32 reactivity at the plasma membrane and endosome. (<italic>A</italic>−<italic>D</italic>) Dose–response curves for Ib32 reactivity at the plasma membrane using LgBiT-CAAX, and at the endosome using SmBiT-FYVE, coexpressed with the corresponding Ib32 constructs, upon agonist-stimulation of V2R and AT1R, respectively (mean±SEM, n = 4, fold normalized with respect to the response at the lowest concentration treated as 1).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig05.jpg"><?cloudpmc-path blobs/cb6a/12452856/42a129190366/pnas.2507384122fig05.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1497?><?original-width 1929?><?scaled-height 598?><?scaled-width 771?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig05.gif"><?cloudpmc-path blobs/cb6a/12452856/8bb4d4b220b1/pnas.2507384122fig05.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="s6" disp-level="2"><title>Ib32 Reveals Conformational Diversity in GPCR–βarr Complexes.</title><p>We have previously developed and characterized an intrabody sensor referred to as intrabody30 (Ib30) based on an antibody fragment Fab30 (<xref rid="r8" ref-type="bibr">8</xref>, <xref rid="r20" ref-type="bibr">20</xref>), which also selectively recognizes GPCR-bound βarr1 conformation (<xref rid="r15" ref-type="bibr">15</xref>, <xref rid="r20" ref-type="bibr">20</xref>). Thus, we compared the reactivity of Ib32 and Ib30 on a selected set of GPCRs to probe whether these two sensors recognize similar or different conformations of βarr1. We selected four distinct GPCRs namely V2R, the complement C5a receptor subtype 1 (C5aR1), Angiotensin II type 1 Receptor (AT1R), and Atypical chemokine receptor 3 (ACKR3). Of these, Ib32 and Ib30 robustly recognized agonist-induced βarr1 conformation for the V2R, while they both did not exhibit any measurable response for the ACKR3 (<xref rid="fig06" ref-type="fig">Fig. 6 <italic>A</italic>−<italic>D</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S11 <italic>C</italic>−<italic>E</italic></ext-link>). The lack of response for ACKR3 is not due to the absence of βarr1 recruitment as demonstrated using a NanoBiT assay reporting agonist-induced βarr1 recruitment to the receptor under similar experimental conditions (<xref rid="fig06" ref-type="fig">Fig. 6<italic>A</italic></xref>). These data suggest that upon binding to ACKR3, βarr1 adopts a conformation that is significantly different from that induced by V2R. Interestingly, Ib32 robustly recognizes βarr1 upon stimulation of AT1R but fails to recognize βarr1 for C5aR1 (<xref rid="fig06" ref-type="fig">Fig. 6<italic>C</italic></xref>). On the other hand, Ib30 displays a pattern that is nearly reverse of Ib32 (<xref rid="fig06" ref-type="fig">Fig. 6<italic>B</italic></xref>). Expectedly, AT1R and C5aR1 display robust βarr1 recruitment under similar experimental conditions (<xref rid="fig06" ref-type="fig">Fig. 6<italic>A</italic></xref>). Taken together, these data suggest at least four distinct conformations of βarr1 upon its interaction with V2R, C5aR1, AT1R, and ACKR3, and therefore, underscores the conformational diversity displayed by βarrs upon their interaction with GPCRs. Receptors used in these experiments exhibited surface expression over the mock-transfected condition (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S11 <italic>F</italic>−<italic>H</italic></ext-link>). We acknowledge that our interpretation is based on the presence or absence of Ib30 and Ib32 reactivity, instead of the relative differences in their response window, toward βarr1 upon agonist-stimulation of the indicated receptors. The binding epitopes of Ib30 and Ib32 on βarrs differ significantly, wherein Ib30 binds at the interface of the N- and the C-domain of βarr1, Ib32 recognizes an epitope on the N-domain (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S11 <italic>A</italic> and <italic>B</italic></ext-link>). While both these sensors report an active conformation of βarr1 (i.e., induced by the interaction with GPCRs), the precise nature of these active conformations, including their similarity and differences, requires future investigation. Therefore, further experimentation is necessary, especially using direct structural and biophysical approaches, to better visualize the precise conformational differences at higher resolution.</p><fig id="fig06" position="float"><?disp-level 3?><label>Fig. 6.</label><caption><p>Ib32 sensor reveals conformation diversity in GPCR–βarr complexes. (<italic>A</italic>−<italic>C</italic>) βarr1 recruitment, Ib30 reactivity, and Ib32 reactivity depicted in panels <italic>A</italic>, <italic>B</italic>, and <italic>C</italic>, respectively, for the indicated receptors upon stimulation with increasing concentrations of respective agonists (mean±SEM, n = 4, fold normalized with respect to the response at the lowest concentration treated as 1). (<italic>D</italic>) Representation of the βarr1 recruitment, Ib30 and Ib32 reactivity response for the indicated receptors as a heat map at maximal agonist concentrations based on the data presented in panels <italic>A</italic>−<italic>C</italic>. The fold response values of βarr1 recruitment are divided by six to match the range of Ib30/Ib32 reactivity levels for clarity of presentation.</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig06.jpg"><?cloudpmc-path blobs/cb6a/12452856/9c5a331f6e71/pnas.2507384122fig06.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1574?><?original-width 1981?><?scaled-height 629?><?scaled-width 792?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig06.gif"><?cloudpmc-path blobs/cb6a/12452856/cc537f9cf21d/pnas.2507384122fig06.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="s7" disp-level="2"><title>Phosphorylation Sites in the B2R Driving Ib32 Reactivity.</title><p>As Ib32 exhibits the strongest signal in the case of B2R, we next set out to identify the contribution of distinct phosphorylation sites in the B2R driving βarr interaction and conformation activation as recognized by Ib32. We generated a series of phosphorylation site mutants of B2R as depicted in <xref rid="fig07" ref-type="fig">Fig. 7<italic>A</italic></xref> and measured their ability to recruit βarrs upon agonist-stimulation and the reactivity of Ib32 using the NanoBiT assay in parallel. We observed that most of the mutants maintained βarr recruitment and Ib32 reactivity to the levels comparable to wild-type receptor at saturating dose of agonist (<xref rid="fig07" ref-type="fig">Fig. 7 <italic>B</italic> and <italic>C</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S12 <italic>A</italic>−<italic>H</italic></ext-link>). However, a combination of Thr<sup>372</sup>Ala and Ser<sup>373</sup>Ala nearly abolished Ib32 reactivity despite maintaining robust βarr recruitment (<xref rid="fig07" ref-type="fig">Fig. 7 <italic>A</italic>−<italic>G</italic></xref> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S12 <italic>A</italic>−<italic>H</italic></ext-link>). We further corroborated these data using full dose–response curves and observed near-complete loss of Ib32 reactivity for the B2R<sup>T372A+S373A</sup> mutant despite robust βarr recruitment (<xref rid="fig07" ref-type="fig">Fig. 7 <italic>D</italic>−<italic>G</italic></xref>). These data suggest that phosphorylation of Thr<sup>372</sup> and Ser<sup>373</sup> is critical for imparting a βarr conformation that is recognized by Ib32. We note that the lack of Ib32 reactivity for the B2R mutant does not mean a lack of βarr activation, but it rather represents a βarr conformation that is not permissive to Ib32 binding. In other words, βarr may still be adopting an active-like conformation resulting from its interaction with the receptor, however, Ib32 epitope is not fully exposed, leading to an absence of Ib32 reactivity. To further investigate the functional implications of these conformational differences, we measured agonist-induced trafficking patterns of βarrs as well as ERK and RhoA activation for the wild-type and mutant receptor (i.e. B2R<sup>WT</sup> and B2R<sup>T372A+S373A</sup>). However, we did not observe any major differences between the wild-type and the mutant receptors in these assays although agonist-induced translocation of βarrs to the plasma membrane were slightly compromised for the mutant receptor (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S13 <italic>A</italic>−<italic>P</italic></ext-link>). Therefore, further studies are required to link the conformational differences reported by Ib32 sensor with functional outcomes for the B2R mutant. The surface expression of the wild-type and mutant B2R constructs was comparable in these assays (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S14 <italic>A</italic>−<italic>N</italic></ext-link>).</p><fig id="fig07" position="float"><?disp-level 3?><label>Fig. 7.</label><caption><p>Effect of B2R phosphorylation site mutation on βarr recruitment and Ib32 reactivity. (<italic>A</italic>) Schematic representation of B2R carboxy-terminus highlighting the potential phosphorylation site. (<italic>B</italic> and <italic>C</italic>) Representation of βarr1/2 recruitment and Ib32 reactivity data for the B2R phosphorylation site mutants upon agonist-stimulation as a heat map (mean of three independent experiments, fold normalized with respect to unstimulated condition treated as 1). The fold response values of βarr1 recruitment are divided by four to match the range of Ib32 reactivity levels for clarity of presentation. (<italic>D−G</italic>) Dose–response curves of βarr1/2 recruitment (Panels <italic>D</italic> and <italic>E</italic>) and Ib32 reactivity (Panel <italic>F</italic> and <italic>G</italic>) upon agonist-stimulation of the wild-type and mutant receptor (mean±SEM, n = 3 to 4, fold normalized with respect to the response at the lowest concentration treated as 1).</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig07.jpg"><?cloudpmc-path blobs/cb6a/12452856/44fea6b93d00/pnas.2507384122fig07.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1973?><?original-width 2200?><?scaled-height 657?><?scaled-width 733?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig07.gif"><?cloudpmc-path blobs/cb6a/12452856/421d67bec5d3/pnas.2507384122fig07.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="s8" disp-level="2"><title>Limited Proteolysis Corroborates Conformation Diversity in βarr Activation.</title><p>Finally, we employed a limited proteolysis assay to corroborate the conformational diversity imparted by different GPCRs on βarrs. For this, we used phosphopeptides derived from the carboxyl-terminus of multiple GPCRs to activate βarrs <italic>in-vitro</italic> (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S15</ext-link>). In these experiments, we first activated purified βarr1 using saturating concentrations of phosphopeptides followed by limited trypsin proteolysis and monitored the kinetics of proteolysis as a readout of βarr activation. We observed that the kinetics of limited proteolysis for V2Rpp vs. B2Rpp were different from each other, wherein B2Rpp binding shows a slower rate of proteolysis compared to that of V2Rpp (<xref rid="fig08" ref-type="fig">Fig. 8 <italic>A</italic> and <italic>C</italic></xref>). Moreover, phosphopeptides derived from different GPCRs and containing distinct phosphorylation patterns also exhibited differential kinetics of limited proteolysis (<xref rid="fig08" ref-type="fig">Fig. 8 <italic>B</italic> and <italic>D</italic></xref>). Taken together with the Ib32 reactivity data, these findings underscore the conformational fine-tuning in βarr1 upon activation by distinct phosphorylation patterns harbored in different GPCRs.</p><fig id="fig08" position="float"><?disp-level 3?><label>Fig. 8.</label><caption><p>Limited trypsin proteolysis corroborates conformational diversity of βarrs. (<italic>A</italic>) Representative images for the limited trypsin proteolysis assay of βarr1 activated by V2Rpp and B2Rpp at indicated time-points. (<italic>B</italic>) Representative images for the limited trypsin proteolysis assay of βarr1 activated by different phosphopeptides at indicated time-points (<italic>C</italic>) Densitometry-based quantification of the band corresponding to Gly<sup>−8</sup>–Arg<sup>418</sup> of βarr1 activated by V2Rpp and B2Rpp at indicated time points (mean±SEM, n = 4, % normalized with respect to the uncut condition at each time point treated as 100%). (<italic>D</italic>) Densitometry-based quantification of the band corresponding to Gly<sup>−8</sup>–Arg<sup>418</sup> of βarr1 activated by different phosphopeptides at indicated time points (mean±SEM, n = 4, normalized as in panel <italic>C</italic>). (<italic>E</italic>) A schematic representation depicting conformational diversity of βarrs facilitating their interaction with, and regulation of, a broad repertoire of GPCRs.</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" xlink:href="pnas.2507384122fig08.jpg"><?cloudpmc-path blobs/cb6a/12452856/9bcb4f8ef112/pnas.2507384122fig08.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 2279?><?original-width 2085?><?scaled-height 760?><?scaled-width 695?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="pnas.2507384122fig08.gif"><?cloudpmc-path blobs/cb6a/12452856/d13a019e641c/pnas.2507384122fig08.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec></sec><sec id="s9" disp-level="1"><title>Discussion</title><p>In this study, we develop Ib32 as a sensor to monitor βarr activation upon their interaction with GPCRs and employ it in cellular context to demonstrate conformational diversity in GPCR–βarr complexes. We acknowledge that Ib32 may not be a universal sensor of βarr recruitment and activation as we observe its reactivity for only a small subset of receptors tested here. This likely reflects the conformational diversity in βarrs upon their interaction with different GPCRs, resulting from distinct phosphorylation patterns as well as receptor core-mediated fine-tuning of βarr conformation. Interestingly, for some receptors such as CXCR2, Ib32 yields clear response upon agonist stimulation although the response window is relatively weaker compared to other GPCRs. This may result from a lower expression level of these receptors, and further optimization including a careful comparison of different constructs may help improve the response. Still, it is likely that the Ib32 biosensor may not work for every receptor despite extensive optimization of the constructs and expression levels, which represents a potential limitation of this biosensor. Still however, Ib32 expands the currently available toolset to probe the intricate details of βarr activation and signaling regulation for the receptors where it exhibits a robust reactivity. We also acknowledge that the experiments described here are carried out in HEK-293T cells that also express a significant level of endogenous βarrs. Although the signal in our assays arises specifically from recombinantly expressed intrabody constructs, it is plausible that the endogenous βarrs may compete, albeit to a small extent, for receptor binding and recognition by the intrabody sensor. Therefore, experiments with βarr depleted cell lines may result in an even stronger signal in these assays. It is interesting to note that Ib32 sensor reports βarr1 activation with a stronger signal compared to βarr2 for some receptors while it is equally efficient for others. This is in line with previous studies based on intramolecular FlAsH-BRET sensors of βarrs, which have illuminated receptor-specific βarr conformational signature (<xref rid="r16" ref-type="bibr">16</xref>, <xref rid="r17" ref-type="bibr">17</xref>), and also conformational differences between the βarr isoforms when activated by the same receptor (<xref rid="r15" ref-type="bibr">15</xref>, <xref rid="r36" ref-type="bibr">36</xref>, <xref rid="r37" ref-type="bibr">37</xref>). Still however, the variations in the basal signal between βarr1 vs. βarr2 for different receptors may also impact the response window, and it should be individually optimized to unequivocally conclude a preferential recognition of βarr1 by the Ib32 biosensor.</p><p>We observed that the Ib32 sensor described here displays a robust change in linear dichroism upon activation of βarrs by three different GPCRs tested here. Although the direction of changes in linear dichroism was similar for all three receptors and βarr isoforms, we observed slightly stronger agonist-induced signals for βarr1 vs. βarr2, despite detecting larger baseline activity in βarr2. The observed linear dichroism changes upon stimulation of AT1R by AngII were larger compared to that for the TRV027, which corresponds with their βarr recruitment profile. A number of previous studies have demonstrated that biased agonists typically induce a distinct βarr conformation compared to that induced by unbiased or balanced agonists (<xref rid="r38" ref-type="bibr">38</xref>), and therefore, it is likely that Ib32 sensor, either in the NanoBiT format or in linear dichroism setting, is not able to differentiate between such conformational differences. A series of recent studies have proposed different phosphorylation signatures and motifs in GPCRs as critical determinants of βarr interaction and activation (<xref rid="r12" ref-type="bibr">12</xref>, <xref rid="r14" ref-type="bibr">14</xref>, <xref rid="r39" ref-type="bibr">39</xref>–<xref rid="r41" ref-type="bibr">41</xref>). Moreover, several biochemical and cellular studies using site-directed mutagenesis and functional assays have also linked specific βarr conformations to downstream responses (<xref rid="r27" ref-type="bibr">27</xref>, <xref rid="r28" ref-type="bibr">28</xref>, <xref rid="r42" ref-type="bibr">42</xref>–<xref rid="r45" ref-type="bibr">45</xref>). As evidenced by differences in temporal profiles of Ib32-meGFP-H-Ras between different receptors, our polarization microscopy experiments also reveal differences in temporal aspects of GPCR–βarr interactions. However, at present, variability of responses between individual cells (at least partially attributable to differences in expression levels) precludes making reliable detailed observations. While it is possible that the observed responses were affected by the mCherry tag on the βarr constructs, these constructs have been extensively tested previously (<xref rid="r20" ref-type="bibr">20</xref>). Furthermore, the use of tagged βarr constructs in the current study does not undermine the ability of the biosensor to report βarr activation. We also note that kinetic aspects of βarrs interaction with GPCRs and other cellular partners as well as subcellular trafficking are very important and certainly worth investigating further. In principle, our polarization microscopy setup should allow such studies as its temporal resolution is limited primarily by the rate of image acquisition. However, we have observed considerable heterogeneity in responses among the individual cells measured in our experiments, likely due to heterogeneity in the expression levels of the receptor, βarrs, and the intrabody sensor. Therefore, future studies focused on quantitative kinetic measurements using better-controlled expression conditions, for example, by using stable cell lines, may provide additional information about βarr conformational landscape.</p><p>The data presented here with Ib32 sensor underscores an additional level of conformational diversity in βarrs that is imparted and fine-tuned in receptor-specific manner (<xref rid="fig08" ref-type="fig">Fig. 8<italic>E</italic></xref>), and future studies focused on direct structural visualization of these complexes may provide further insights. We acknowledge that our interpretation of conformational diversity in βarrs upon their interaction with different receptors is based on the reactivity patterns of Ib30 and Ib32 biosensors. However, the precise nature of these conformational differences remains to be explored further using additional biophysical and structural methods in future studies. Along the same line, the functional consequences of βarr conformational differences between the wild-type and phospho-site mutant of B2R as reported by Ib32 biosensor warrant further analysis to measure additional aspects of receptor signaling and regulation.</p><p>In conclusion, we present the development and characterization of Ib32 as a genetically encoded sensor of βarr recruitment and activation for selected GPCRs. Taken together with a previously described Ib30 sensor, it demonstrates the existence of distinct conformational signatures in βarrs for different GPCRs, and going forward, it should complement the existing biosensors for visualizing novel aspects of GPCR–βarr interaction and activation.</p></sec><sec id="s10" disp-level="1"><title>Materials and Methods</title><sec id="s11" disp-level="2"><title>General Reagents, Plasmids, and Cell Culture.</title><p>Most of the standard reagents were purchased from Sigma Aldrich unless specified otherwise. Dulbecco′s modified Eagle′s medium (DMEM), phosphate buffer saline (PBS), trypsin-EDTA, fetal bovine serum (FBS), Hank’s balanced salt solution (HBSS), and penicillin–streptomycin solution were purchased from Thermo Fisher Scientific. HEK-293T cells were purchased from ATCC and maintained in 10% (v/v) FBS (Gibco, Cat. no. 10270-106) and 100 U ml<sup>−1</sup> penicillin and 100 µg ml<sup>−1</sup> streptomycin (Gibco, Cat. no. 15140122) supplemented DMEM (Gibco, Cat. no. 12800-017) at 37 °C under 5% CO<sub>2</sub>. The expression constructs for the receptors, βarrs, NanoBiT-CAAX, and Ib30 have been described previously (<xref rid="r13" ref-type="bibr">13</xref>, <xref rid="r20" ref-type="bibr">20</xref>, <xref rid="r27" ref-type="bibr">27</xref>, <xref rid="r32" ref-type="bibr">32</xref>, <xref rid="r33" ref-type="bibr">33</xref>, <xref rid="r46" ref-type="bibr">46</xref>–<xref rid="r49" ref-type="bibr">49</xref>). HA-tagged Ib32 construct was cloned in pcDNA3.1 vector by the traditional cloning method with restriction enzymes BamHI and NotI. Amino acid sequence of HA-Ib32 is as mentioned below: MQVQLQESGGGLVQAGGSLRLSCVVSGFFFDTVTMAWYRRAPGKHRELVASATAGGTTTYADSVKDRFTISRDNAKNTVYLQMNSLKPEDTAVYYCNTFVRSLSWGQGTQVTVSSYPYDVPDYA. Ib32 constructs in NanoBiT format as described in <xref rid="fig01" ref-type="fig">Fig. 1<italic>B</italic></xref> were generated by subcloning the Ib32 coding region in pCAGGS vector as described previously for Ib30 (<xref rid="r27" ref-type="bibr">27</xref>). For linear dichroism imaging, the Ib32-mEGFP-hRas construct was cloned into mEGFP-H-Ras cassette in a pcDNA3.1(+) vector. B2R phosphorylation site mutants mentioned in the manuscript were generated by site-directed mutagenesis using Q5 Site-directed mutagenesis kit (NEB, Cat. No. E0554). All DNA constructs used in this study were verified by sequencing from Macrogen. Arginine Vasopressin (AVP), Angiotensin II (AngII), Bradykinin (BK), Motilin-22, and Kisspeptin-10 were synthesized from GenScript. Niacin and Carbachol were purchased from Himedia (Cat. no. TC157) and Cayman Lifesciences (Cat. no. 14486), respectively. C5a, C3a, CCL7, CXCL8, CXCL11, and CXCL12 were purified from the <italic>Escherichia coli</italic> BL21(DE3) cells following the protocols described previously (<xref rid="r50" ref-type="bibr">50</xref>–<xref rid="r52" ref-type="bibr">52</xref>).</p></sec><sec id="s12" disp-level="2"><title>Receptor Surface Expression.</title><p>Surface expression of the receptors in various assays was measured using a whole cell–based surface ELISA protocol reported previously (<xref rid="r53" ref-type="bibr">53</xref>). Briefly, transfected cells were seeded in 0.01% poly-D-Lysine pretreated 24-well plate at a density of 2 × 10<sup>5</sup> cells well<sup>−1</sup>. Post 24 h of incubation, once cells were washed with ice-cold 1X TBS, followed by fixation with 4% PFA (w/v in 1X TBS) on ice for 20 min. Fixed cells were then washed with 1X TBS for three times followed by blocking with 1% BSA (w/v in 1X TBS) at room temperature for 90 min. Post blocking, 200 μL anti-FLAG M2-HRP was added and incubated for 90 min (prepared in 1% BSA, 1:10,000) (Sigma, Cat. no. A8592). Postblocking, cells were washed with 1% BSA (prepared in 1X TBS) three times to remove unbound antibodies. Signal was developed by treating cells with 200 μL TMB-ELISA (Thermo Scientific, Cat no. 34028) until the light blue color appeared, and the reaction was quenched by transferring the solution to a 96-well plate containing 100 μL 1 M H<sub>2</sub>SO<sub>4</sub>. The absorbance of the signal was measured at 450 nm using a multimode plate reader. After taking absorbance of the signal for FLAG tagged receptor, cells were washed once with 1X TBS followed by incubation with 0.2% w/v Janus Green (Sigma; Cat. no. 201677) for 15 min. Afterward, Janus Green was aspirated followed by washing with distilled water to remove the excess stain. To elute the stain, 800 μL of 0.5 N HCl was added. To record the absorbance of Janus, 200 μL of the eluate was transferred to a 96-well plate and absorbance was measured at absorbance 595 nm. Data were analyzed by calculating the ratio of absorbance at 450/595 followed by normalizing the value of pcDNA-transfected cells reading as 1, and the values were plotted using GraphPad Prism v 9.5.0 software.</p></sec><sec id="s13" disp-level="2"><title>NanoBiT Enzyme Complementation Assay.</title><p>NanoBiT assay to monitor GPCR–βarr interaction and Ib32/Ib30 reactivity was carried out following the previously described protocols (<xref rid="r13" ref-type="bibr">13</xref>, <xref rid="r20" ref-type="bibr">20</xref>, <xref rid="r27" ref-type="bibr">27</xref>, <xref rid="r32" ref-type="bibr">32</xref>, <xref rid="r46" ref-type="bibr">46</xref>–<xref rid="r48" ref-type="bibr">48</xref>, <xref rid="r52" ref-type="bibr">52</xref>). For the Ib32 reactivity assay described here, various combinations of LgBiT and SmBiT tagged at the N-terminus and C-terminus of βarr1/2 and Ib32 were screened to obtain the optimal combination. HEK-293T cells were transfected with 3 µg of receptor, 2 µg of βarr1/2 (with indicated fusion of LgBiT and SmBiT), and 5 µg of Ib32 (with indicated fusion of LgBiT and SmBiT) using the transfection reagent polyethyleneimine (PEI) linear at DNA: PEI ratio of 1: 3. After 16 to 18 h of transfection, cells were harvested and resuspended in the NanoBiT assay buffer containing 1X HBSS, 0.01% BSA, 5 mM HEPES pH 7.4, and 10 μM coelenterazine (GoldBio, Cat. no. CZ05). Afterward, resuspended cells were seeded at a density of 1 × 10<sup>5</sup> cells well<sup>−1</sup> in an opaque flat bottom 96-well plate. Postincubation, basal level luminescence readings were recorded, followed by the addition of 1 μM arginine vasopressin (AVP). Luminescence upon stimulation was recorded for 20 cycles (each cycle was recorded for 2 min 30 s) using a multimode plate reader (BMG Labtech). Luminescence signal of 5 to 10 cycles (11 to 23 min) after stimulation was averaged, normalized w.r.t. the lowest agonist concentration and plotted for the presentation. We observed the maximal response with N-terminally LgBiT tagged Ib32 and βarr with SmBiT at the N-terminus, and this combination was used in subsequent experiments. A similar combination of SmBiT-tagged βarr and LgBiT fused Ib30 was also used to probe Ib30 reactivity for βarr activated by the indicated receptors. For analysis, stimulated readings were normalized with respect to the signal of minimal ligand concentration as 1 and plotted using nonlinear regression analysis in GraphPad Prism v 9.5.0 software. For βarr recruitment assay, HEK-293T cells were transfected with 3.5 μg of receptor fused with SmBiT at the C-terminus and 3.5 μg of N-terminally LgBiT tagged βarr1/2 followed by the same procedure as described above. To measure βarr recruitment to B2R phosphorylation site mutants, bystander NanoBiT-based was used, where HEK-293T cells were transfected with 5 μg of receptor, 2 μg of N-terminally SmBiT fused βarr1/2, and 5 μg LgBiT-CAAX construct. In the experiments measuring plasma membrane and endosomal recruitment of Ib32, cells were transfected with 2 µg of the receptor and 2 µg of βarr1 together with either 4 µg of SmBiT-Ib32 + 4 µg of LgBiT-CAAX or 4 µg of LgBiT-Ib32 + 4 µg of FYVE-SmBiT. We also note that we first used the bystander method to monitor βarr recruitment to B2R mutants (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S13 <italic>E</italic>, <italic>F</italic>, <italic>I</italic>, and <italic>J</italic></ext-link>), and subsequently used the direct recruitment method to generate the full dose–response curves for the wild-type and mutant receptor (<xref rid="fig07" ref-type="fig">Fig. 7 <italic>D</italic> and <italic>E</italic></xref>).</p></sec><sec id="s14" disp-level="2"><title>Coimmunoprecipitation Assay.</title><p>To measure the Ib32 reactivity to βarr1/2 upon stimulation of V2R, a coimmunoprecipitation (co-IP) assay was carried out following a previously described protocol (<xref rid="r54" ref-type="bibr">54</xref>). Briefly, HEK-293T cells were cotransfected with 3 μg of N-terminally FLAG tagged V2R, 1.5 μg of βarr1 or 2 μg of βarr2, and 4 μg of Ib32 fused with HA tag at the C-terminus. Post 48 h of transfection, complete DMEM is replaced with incomplete DMEM for serum starvation for 6 h. Afterward, cells were stimulated with 1 μM AVP for 15 min, harvested, resuspended in 100 μL lysis buffer (20 mM HEPES pH 7.4, 450 mM NaCl, 0.1 mM PMSF, 0.2 mM Benzamidine, and 1X Phosphatase inhibitor cocktail), and lysed by dounce homogenization. Postlysis, the sample was solubilized with 1% L-MNG (maltose neopentyl glycol) for 1 h at room temperature. For the experiment presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S2<italic>B</italic></ext-link>, supernatant was allowed to bind with the anti-HA antibody bound beads, followed by washing with wash buffer (20 mM HEPES, pH 7.4, 100 mM NaCl) and elution using 30 μL 2X SDS reducing dye. For the co-IP data presented in <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="http://www.pnas.org/lookup/doi/10.1073/pnas.2507384122#supplementary-materials" ext-link-type="uri"><italic>SI Appendix</italic>, Fig. S2<italic>A</italic></ext-link>, M1-FLAG beads were used, and the beads were subjected to alternative washes with low salt buffer (20 mM HEPES pH 7.4, 150 mM NaCl, 2 mM CaCl<sub>2</sub>, 0.01% L-MNG) and high-salt buffer (20 mM HEPES pH 7.4, 350 mM NaCl, 2 mM CaCl<sub>2</sub>, 0.01% L-MNG), followed by elution with FLAG-EDTA buffer (20 mM HEPES pH 7.4, 150 mM NaCl, 2 mM EDTA, 0.01% L-MNG, 250 μg/mL FLAG peptide). Samples were then subjected to separation by SDS-polyacrylamide gel electrophoresis and transferred to PVDF (Polyvinylidene fluoride) membrane. Afterward, βarr1/2, Ib32, and the receptors were probed using βarr1/2 antibody (1:5000, CST, Cat. no. 4674), monoclonal anti-rabbit IgG peroxidase coupled antibody, anti-HA antibody (1:5000; Santa-Cruz; cat. no. sc-805), and anti-FLAG peroxidase coupled antibody (1:5000, Sigma-Aldrich, Cat. no. A8592), respectively. Signals were detected using a Chemiluminescence Documentation imaging system (BioRad), densitometry-based quantification was carried out using ImageJ software suite, and data were plotted using GraphPad Prism v 9.5.0 Software.</p></sec><sec id="s15" disp-level="2"><title>Ib32 Sensor Design and Experimental Details for Single Photon Polarization Microscopy.</title><p>The Ib32-meGFP-H-Ras construct was prepared by PCR amplification of the Ib32 gene, restriction digestion by XbaI/XhoI, and cloning into the corresponding sites of an meGFP-H-Ras cassette in a pcDNA3.1(+) vector, prepared by gene synthesis (GenScript). Prior to polarization microscopy imaging, cells (HEK-293) were plated in 8-well µ-slides (iBidi, Germany) and transfected using Lipofectamine 3000 (Thermo Fisher Scientific) and a procedure recommended by the manufacturer. Transfection was carried out using 500 ng each of plasmids encoding Ib32-meGFP-H-Ras, the studied GPCR (V2R, B2R, or AT1R), and βarr1-mCherry or βarr2-mCherry. After transfection, cells were incubated at 37 °C overnight. For activations, agonists were manually added by pipetting, to a final concentration of 1 µM. Cells were observed by single-photon polarization microscopy prior to the addition of an agonist, and 5 and 15 min after adding an agonist. In these experiments, we have used triple transfection and monitored the expression of two fluorescently tagged proteins (i.e., Ib32 and βarrs). We observed that most of the cells (&gt;95%) expressed both proteins and, therefore, we extrapolate that they will also express the receptor. The data represent three independent experiments, i.e., transfections.</p><p>Single-photon polarization microscopy was performed as described previously (<xref rid="r35" ref-type="bibr">35</xref>, <xref rid="r55" ref-type="bibr">55</xref>) using an Olympus FV1200 confocal microscope equipped with a polarization modulator (2P FLIPper, Innovative Bioimaging, s.r.o. Czechia) alternating the direction of the excitation light polarization between acquisition of subsequent pixels. Ib32-meGFP-H-Ras was observed using laser light of 488 nm wavelength and 80 µW intensity, through a 40X water immersion objective lens (UApoN340, NA1.15, Olympus, Japan). Images containing information on fluorescence intensities observed with both horizontal and vertical excitation polarizations were deconvolved and quantitatively processed in ImageJ/Fiji, using publicly available macros described previously (<xref rid="r55" ref-type="bibr">55</xref>). The extent of linear dichroism was characterized by a value of the maximum dichroic log ratio, defined as the base-2 logarithm of the ratio of fluorescence intensities observed with light polarized horizontally and vertically in the image, in a section of the cell membrane whose normal was oriented horizontally in the image. For each combination of constructs and experimental conditions, at least 15 cells were observed and analyzed, from at least 3 independent experiments (transfections carried out on three different days). The resulting values of log<sub>2</sub>(<italic>r</italic><sub>max</sub>) were statistically analyzed and plotted using GraphPad Prism v 9.5.0 software. In accordance with our previous observations (<xref rid="r35" ref-type="bibr">35</xref>, <xref rid="r55" ref-type="bibr">55</xref>), values of log<sub>2</sub>(<italic>r</italic><sub>max</sub>) were treated as normally distributed. Statistical significance was assessed by paired or unpaired <italic>t</italic>-test, as appropriate.</p></sec><sec id="s16" disp-level="2"><title>Assessment of ERK/RhoA Activation Using SRE/SRF-Based Reporter Assay.</title><p>To study ERK and RhoA activation upon stimulation of B2R<sup>WT</sup> and B2R<sup>T372A+S373A</sup>, we used SRE and SRF-based reporter assay, respectively, as described previously (<xref rid="r56" ref-type="bibr">56</xref>). In brief, 3 µg B2R constructs along with 7 µg SRE/SRF-RE plasmid were transfected. After 12 to 16 h, transfected cells were trypsinized and seeded at a density of 1 × 10<sup>5</sup> cells per well in a 96-well plate. Cells were then allowed to settle, and then complete DMEM was removed, followed by the addition of 100 µL of serum-free DMEM in each well and cells were subjected to 12 h serum starvation. After serum starvation, cells were stimulated with bradykinin (BK) at concentrations ranging from 10 µM to 1 pM and incubated for 3 h. Subsequently, incomplete media were replaced with assay buffer containing 1X HBSS, 1 mM HEPES pH 7.4, and 0.5 mg/mL luciferin (GoldBio, Cat no. LUCNA-1G). After stimulation, agonist-induced luminescence was recorded. The agonist-induced response was normalized considering the luminescence signal obtained for the minimum dose of agonist as one.</p></sec><sec id="s17" disp-level="2"><title>Limited Trypsin Proteolysis Assay.</title><p>As an orthogonal approach to measure activation-dependent βarr conformational change, we employed a limited trypsin proteolysis assay as described previously (<xref rid="r48" ref-type="bibr">48</xref>, <xref rid="r57" ref-type="bibr">57</xref>, <xref rid="r58" ref-type="bibr">58</xref>) with minor modifications. Briefly, 5 µg of βarr1 was incubated with 10X molar excess of indicated phosphopeptides for 40 min in ice-cold reaction buffer (20 mM HEPES pH 7.4, 100 mM NaCl). Following activation, 20 µL aliquot was collected as the time zero control and TPCK-treated trypsin was added at a 1: 200 (w/w) trypsin: βarr1 ratio, and the mixture was incubated at 37 °C. Then, 20 µL sample was withdrawn at different time intervals and quenched with 5 µL SDS-protein loading dye. Then, 10 µL sample was run on a 12% SDS-PAGE for quantitative analysis. The decrease in intensity of the Gly<sup>−8</sup> to Arg<sup>418</sup> (48 kDa) band was quantified by densitometry, and data were plotted using GraphPad Prism v 9.5.0 software.</p></sec></sec><sec id="sec18" disp-level="1"><title>Supplementary Material</title><supplementary-material id="supplementary-material1" position="float"><caption><p>Appendix 01 (PDF)</p></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="pnas.2507384122.sapp.pdf" mimetype="application" mime-subtype="pdf"><?cloudpmc-path cb6a/12452856/b7c2662d08dc/pnas.2507384122.sapp.pdf?><?cloudpmc-bucket app?><?size 3042335?></media></supplementary-material><supplementary-material id="supplementary-material2" position="float"><caption><p>Dataset S01 (XLSX)</p></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="pnas.2507384122.sd01.xlsx" mimetype="application" mime-subtype="vnd.openxmlformats-officedocument.spreadsheetml.sheet"><?cloudpmc-path cb6a/12452856/61736a7d90c3/pnas.2507384122.sd01.xlsx?><?cloudpmc-bucket app?><?size 302724?></media></supplementary-material></sec><sec id="ack1" sec-type="ack" disp-level="1"><title>Acknowledgments</title><p>This work is supported by an Indo-Czech collaborative research grant from the Department of Science and technology, Government of India (File No. DST/INT/Czech/P-03/2019) and Science and Engineering Research Board(SPR/2020/000408). In addition, the research program in the laboratory of A.K.S. is supported by the Senior Fellowship of DBT Wellcome Trust India Alliance (IA/S/20/1/504916) and Indian Council for Medical Research (F.NO.52/15/2020/BIO/BMS). A.K.S. is a recipient of the Sonu Agrawal Memorial Chair from IIT Kanpur. The research on this project in J.L.’s laboratory is supported by an InterExcellence/Inter-Action grant LTAIN19167 by the Ministry of Education, Science and Sports of the Czech Republic and the European Innovation Council PathFinder Project UniSens. We thank Pragyashree Bhowmick for assisting with limiting proteolysis experiments and Manisankar Ganguly for preparing <xref rid="fig01" ref-type="fig">Fig. 1<italic>A</italic></xref>.</p><sec id="s19" disp-level="2"><title>Author contributions</title><p>P.S., V.N.M., A.D., S.M., J.L., and A.K.S. designed research; P.S., V.N.M., A.D., S.M., N.Z., D.T., M.K.Y., N.R., G.M., and P.M. performed research; P.S., V.N.M., A.D., S.M., J.L., and A.K.S. analyzed data; and P.S., V.N.M., A.D., S.M., J.L., and A.K.S. wrote the paper.</p></sec><sec id="s20" disp-level="2"><title>Competing interests</title><p>J. Lazar is a founder and CEO of Innovative Bioimaging, s.r.o. and Innovative Bioimaging, L.L.C, companies producing equipment for polarization-resolved confocal microscopy. The companies did not materially contribute to the presented research, although they may indirectly benefit from it.</p></sec></sec><sec id="fn-group1" sec-type="fn-group" disp-level="1"><title>Footnotes</title><fn-group><fn id="fn4"><p>This article is a PNAS Direct Submission. J.S.G. is a guest editor invited by the Editorial Board.</p></fn></fn-group></sec><sec id="_ci93_" xml:lang="en" sec-type="contrib-info" disp-level="1"><title>Contributor Information</title><p>Josef Lazar, Email: josef.lazar@lf1.cuni.cz.</p><p>Arun K. Shukla, Email: arshukla@iitk.ac.in.</p></sec><sec id="s18" disp-level="1"><title>Data, Materials, and Software Availability</title><p>All study data are included in the article and/or <ext-link xmlns:xlink="http://www.w3.