{"version":"6.9","hitCount":1,"request":{"queryString":"DOI:10.1038/s41467-024-51451-1","resultType":"core","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"39174501","source":"MED","pmid":"39174501","pmcid":"PMC11341715","fullTextIdList":{"fullTextId":["PMC11341715"]},"doi":"10.1038/s41467-024-51451-1","title":"Structural insights into Frizzled3 through nanobody modulators.","authorString":"Hillier J, Zhao Y, Carrique L, Malinauskas T, Ruza RR, Chang TH, Yi G, Duyvesteyn HME, Yu J, Lu W, Pardon E, Steyaert J, Zhu Y, Ni T, Jones EY.","authorList":{"author":[{"fullName":"Hillier J","firstName":"James","lastName":"Hillier","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Zhao Y","firstName":"Yuguang","lastName":"Zhao","initials":"Y","authorId":{"type":"ORCID","value":"0000-0001-8916-8552"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK. yuguang@strubi.ox.ac.uk."}]}},{"fullName":"Carrique L","firstName":"Loic","lastName":"Carrique","initials":"L","authorId":{"type":"ORCID","value":"0000-0001-5332-8593"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Malinauskas T","firstName":"Tomas","lastName":"Malinauskas","initials":"T","authorId":{"type":"ORCID","value":"0000-0002-4847-5529"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Ruza RR","firstName":"Reinis R","lastName":"Ruza","initials":"RR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Chang TH","firstName":"Tao-Hsin","lastName":"Chang","initials":"TH","authorId":{"type":"ORCID","value":"0000-0001-7242-2585"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Yi G","firstName":"Gangshun","lastName":"Yi","initials":"G","authorId":{"type":"ORCID","value":"0009-0004-6509-4893"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Duyvesteyn HME","firstName":"Helen M E","lastName":"Duyvesteyn","initials":"HME","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Yu J","firstName":"Jing","lastName":"Yu","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Lu W","firstName":"Weixian","lastName":"Lu","initials":"W","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Pardon E","firstName":"Els","lastName":"Pardon","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-2466-0172"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology Brussels, Vrije Universiteit Brussel, VUB, Brussels, Belgium."},{"affiliation":"VIB-VUB Centre for Structural Biology, VIB, Brussels, Belgium."}]}},{"fullName":"Steyaert J","firstName":"Jan","lastName":"Steyaert","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-3825-874X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology Brussels, Vrije Universiteit Brussel, VUB, Brussels, Belgium."},{"affiliation":"VIB-VUB Centre for Structural Biology, VIB, Brussels, Belgium."}]}},{"fullName":"Zhu Y","firstName":"Yanan","lastName":"Zhu","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-1025-7929"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Ni T","firstName":"Tao","lastName":"Ni","initials":"T","authorId":{"type":"ORCID","value":"0000-0001-7268-0306"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK."}]}},{"fullName":"Jones EY","firstName":"E Yvonne","lastName":"Jones","initials":"EY","authorId":{"type":"ORCID","value":"0000-0002-3834-1893"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK. yvonne@strubi.ox.ac.uk."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5332-8593"},{"type":"ORCID","value":"0000-0001-7242-2585"},{"type":"ORCID","value":"0000-0001-7268-0306"},{"type":"ORCID","value":"0000-0001-8916-8552"},{"type":"ORCID","value":"0000-0002-2466-0172"},{"type":"ORCID","value":"0000-0002-3825-874X"},{"type":"ORCID","value":"0000-0002-3834-1893"},{"type":"ORCID","value":"0000-0002-4847-5529"},{"type":"ORCID","value":"0000-0003-1025-7929"},{"type":"ORCID","value":"0009-0004-6509-4893"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"15","journalIssueId":3806395,"dateOfPublication":"2024 Aug","monthOfPublication":8,"yearOfPublication":2024,"printPublicationDate":"2024-08-01","journal":{"title":"Nature communications","medlineAbbreviation":"Nat Commun","isoabbreviation":"Nat Commun","essn":"2041-1723","issn":"2041-1723","nlmid":"101528555"}},"pubYear":"2024","pageInfo":"7228","abstractText":"The Wnt receptor Frizzled3 (FZD3) is important for brain axonal development and cancer progression. We report structures of FZD3 in complex with extracellular and intracellular binding nanobodies (Nb). The crystal structure of Nb8 in complex with the FZD3 cysteine-rich domain (CRD) reveals that the nanobody binds at the base of the lipid-binding groove and can compete with Wnt5a. Nb8 fused with the Dickkopf-1 C-terminal domain behaves as a FZD3-specific Wnt surrogate, activating β-catenin signalling. The cryo-EM structure of FZD3 in complex with Nb9 reveals partially resolved density for the CRD, which exhibits positional flexibility, and a transmembrane conformation that resembles active GPCRs. Nb9 binds to the cytoplasmic region of FZD3 at the putative Dishevelled (DVL) or G protein-binding site, competes with DVL binding, and inhibits GαS coupling. In combination, our FZD3 structures with nanobody modulators map extracellular and intracellular interaction surfaces of functional, and potentially therapeutic, relevance.","affiliation":"Division of Structural Biology, Wellcome Centre for Human Genetics, University of Oxford, Oxford, UK.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"Wellcome Trust","acronym":"WT_","orderIn":0},{"grantId":"DRCRPG-May23/100002","agency":"Cancer Research UK","acronym":"CRUK_","orderIn":0},{"grantId":"C375/A17721","agency":"Cancer Research UK","acronym":"CRUK_","orderIn":0},{"grantId":"203141/Z/16/Z","agency":"Wellcome Trust","acronym":"WT","orderIn":0},{"grantId":"223133/Z/21/Z","agency":"Wellcome Trust","acronym":"WT","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Cryoelectron Microscopy"},{"majorTopic_YN":"N","descriptorName":"Crystallography, X-Ray"},{"majorTopic_YN":"N","descriptorName":"Binding Sites"},{"majorTopic_YN":"N","descriptorName":"Protein Binding"},{"majorTopic_YN":"N","descriptorName":"Models, Molecular"},{"majorTopic_YN":"Y","descriptorName":"Frizzled Receptors","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"beta Catenin","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"HEK293 Cells"},{"majorTopic_YN":"N","descriptorName":"Wnt Signaling Pathway"},{"majorTopic_YN":"Y","descriptorName":"Single-Domain Antibodies","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Dishevelled Proteins","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Protein Domains"}]},"chemicalList":{"chemical":[{"name":"FZD3 protein, human","registryNumber":"0"},{"name":"beta Catenin","registryNumber":"0"},{"name":"Frizzled Receptors","registryNumber":"0"},{"name":"dishevelled proteins","registryNumber":"0"},{"name":"Single-Domain Antibodies","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"doi","site":"Un