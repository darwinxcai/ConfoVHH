{"version":"6.9","hitCount":1,"request":{"queryString":"DOI:10.1016/j.xcrm.2021.100297","resultType":"core","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"34195677","source":"MED","pmid":"34195677","pmcid":"PMC8233664","fullTextIdList":{"fullTextId":["PMC8233664"]},"doi":"10.1016/j.xcrm.2021.100297","title":"CAR T cells targeting tumor-associated exons of glypican 2 regress neuroblastoma in mice.","authorString":"Li N, Torres MB, Spetz MR, Wang R, Peng L, Tian M, Dower CM, Nguyen R, Sun M, Tai CH, de Val N, Cachau R, Wu X, Hewitt SM, Kaplan RN, Khan J, St Croix B, Thiele CJ, Ho M.","authorList":{"author":[{"fullName":"Li N","firstName":"Nan","lastName":"Li","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Torres MB","firstName":"Madeline B","lastName":"Torres","initials":"MB","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Spetz MR","firstName":"Madeline R","lastName":"Spetz","initials":"MR","authorId":{"type":"ORCID","value":"0000-0002-1172-4771"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Wang R","firstName":"Ruixue","lastName":"Wang","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Peng L","firstName":"Luyi","lastName":"Peng","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Tian M","firstName":"Meijie","lastName":"Tian","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-0547-9447"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Genetics Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Dower CM","firstName":"Christopher M","lastName":"Dower","initials":"CM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Mouse Cancer Genetics Program, Center for Cancer Research, National Cancer Institute, Frederick, MD 21702, USA."}]}},{"fullName":"Nguyen R","firstName":"Rosa","lastName":"Nguyen","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Oncology Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Sun M","firstName":"Ming","lastName":"Sun","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Oncology Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Tai CH","firstName":"Chin-Hsien","lastName":"Tai","initials":"CH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"de Val N","firstName":"Natalia","lastName":"de Val","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Molecular Microscopy, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Frederick, MD 21702, USA."},{"affiliation":"Cancer Research Technology Program, Leidos Biomedical Research, Inc., Frederick, MD 21702, USA."}]}},{"fullName":"Cachau R","firstName":"Raul","lastName":"Cachau","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Data Science and Information Technology Program, Leidos Biomedical Research, Frederick, MD 21702, USA."}]}},{"fullName":"Wu X","firstName":"Xiaolin","lastName":"Wu","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Cancer Research Technology Program, Leidos Biomedical Research, Inc., Frederick, MD 21702, USA."}]}},{"fullName":"Hewitt SM","firstName":"Stephen M","lastName":"Hewitt","initials":"SM","authorId":{"type":"ORCID","value":"0000-0001-8283-1788"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Pathology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Kaplan RN","firstName":"Rosandra N","lastName":"Kaplan","initials":"RN","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Oncology Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Khan J","firstName":"Javed","lastName":"Khan","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Genetics Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"St Croix B","firstName":"Brad","lastName":"St Croix","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Mouse Cancer Genetics Program, Center for Cancer Research, National Cancer Institute, Frederick, MD 21702, USA."}]}},{"fullName":"Thiele CJ","firstName":"Carol J","lastName":"Thiele","initials":"CJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Oncology Branch, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}},{"fullName":"Ho M","firstName":"Mitchell","lastName":"Ho","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-9152-5405"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8283-1788"},{"type":"ORCID","value":"0000-0002-1172-4771"},{"type":"ORCID","value":"0000-0002-9152-5405"},{"type":"ORCID","value":"0000-0003-0547-9447"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","related_data"]},"journalInfo":{"issue":"6","volume":"2","journalIssueId":3188031,"dateOfPublication":"2021 Jun","monthOfPublication":6,"yearOfPublication":2021,"printPublicationDate":"2021-06-01","journal":{"title":"Cell reports. Medicine","medlineAbbreviation":"Cell Rep Med","isoabbreviation":"Cell Rep Med","essn":"2666-3791","issn":"2666-3791","nlmid":"101766894"}},"pubYear":"2021","pageInfo":"100297","abstractText":"Targeting solid tumors must overcome several major obstacles, in particular, the identification of elusive tumor-specific antigens. Here, we devise a strategy to help identify tumor-specific epitopes. Glypican 2 (GPC2) is overexpressed in neuroblastoma. Using RNA sequencing (RNA-seq) analysis, we show that exon 3 and exons 7-10 of GPC2 are expressed in cancer but are minimally expressed in normal tissues. Accordingly, we discover a monoclonal antibody (CT3) that binds exons 3 and 10 and visualize the complex structure of CT3 and GPC2 by electron microscopy. The potential of this approach is exemplified by designing CT3-derived chimeric antigen receptor (CAR) T cells that regress neuroblastoma in mice. Genomic sequencing of T cells recovered from mice reveals the CAR integration sites that may contribute to CAR T cell proliferation and persistence. These studies demonstrate how RNA-seq data can be exploited to help identify tumor-associated exons that can be targeted by CAR T cell therapies.","affiliation":"Laboratory of Molecular Biology, Center for Cancer Research, National Cancer Institute, National Institutes of Health, Bethesda, MD 20892, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Research Support, N.I.H., Intramural","Research Support, Non-U.S. Gov't","research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"Z01 BC010891","agency":"Intramural NIH HHS","acronym":"ImNIH","orderIn":0},{"agency":"National Cancer Institute","orderIn":0},{"agency":"NCI Cancer Moonshot","orderIn":0},{"grantId":"U01 CA224766","agency":"NCI NIH HHS","acronym":"CA","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"T-Lymphocytes","meshQualifierList":{"meshQualifier":[{"abbreviation":"IM","qualifierName":"immunology","majorTopic_YN":"N"},{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Cell Line, Tumor"},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Mice, Nude"},{"majorTopic_YN":"N","descriptorName":"Neuroblastoma","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"MO","qualifierName":"mortality","majorTopic_YN":"N"},{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"Y"}]}},{"majorTopic_YN":"N","descriptorName":"Nervous System Neoplasms","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"MO","qualifierName":"mortality","majorTopic_YN":"N"},{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"