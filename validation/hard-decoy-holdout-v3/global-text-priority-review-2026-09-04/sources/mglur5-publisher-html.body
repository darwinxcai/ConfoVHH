                            <li class="c-article-identifiers__item">Published: <time datetime="2019-01-23">23 January 2019</time></li>
                        </ul>

                        <h1 class="c-article-title" data-test="article-title" data-article-title="">Structural insights into the activation of metabotropic glutamate receptors</h1>
                        <ul class="c-article-author-list c-article-author-list--short" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="1_17" data-track-context="researcher popup with no profile" href="#auth-Antoine-Koehl-Aff1" data-author-popup="auth-Antoine-Koehl-Aff1" data-track-label="Antoine Koehl" data-author-search="Koehl, Antoine">Antoine Koehl</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup><sup class="u-js-hide"> <a href="#na1">na1</a></sup>, </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="2_17" data-track-context="researcher popup with no profile" href="#auth-Hongli-Hu-Aff1-Aff2" data-author-popup="auth-Hongli-Hu-Aff1-Aff2" data-track-label="Hongli Hu" data-author-search="Hu, Hongli">Hongli Hu</a><sup class="u-js-hide"><a href="#Aff1">1</a>,<a href="#Aff2">2</a></sup><sup class="u-js-hide"> <a href="#na1">na1</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="3_17" data-track-context="researcher popup with no profile" href="#auth-Dan-Feng-Aff3" data-author-popup="auth-Dan-Feng-Aff3" data-track-label="Dan Feng" data-author-search="Feng, Dan">Dan Feng</a><sup class="u-js-hide"><a href="#Aff3">3</a></sup><sup class="u-js-hide"> <a href="#na1">na1</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="4_17" data-track-context="researcher popup with no profile" href="#auth-Bingfa-Sun-Aff3" data-author-popup="auth-Bingfa-Sun-Aff3" data-track-label="Bingfa Sun" data-author-se