Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA."}]}},{"fullName":"Robertson MJ","firstName":"Michael J","lastName":"Robertson","initials":"MJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Structural Biology, Stanford University School of Medicine, Stanford, CA, USA."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA."}]}},{"fullName":"Chu M","firstName":"Matthew","lastName":"Chu","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"ConfometRx, Santa Clara, CA, USA."}]}},{"fullName":"Kobilka TS","firstName":"Tong Sun","lastName":"Kobilka","initials":"TS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA."},{"affiliation":"ConfometRx, Santa Clara, CA, USA."}]}},{"fullName":"Laeremans T","firstName":"Toon","lastName":"Laeremans","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology Brussels, Vrije Universiteit Brussel (VUB), Brussels, Belgium."},{"affiliation":"VIB-VUB Center for Structural Biology, VIB, Brussels, Belgium."}]}},{"fullName":"Steyaert J","firstName":"Jan","lastName":"Steyaert","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-3825-874X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Structural Biology Brussels, Vrije Universiteit Brussel (VUB), Brussels, Belgium."},{"affiliation":"VIB-VUB Center for Structural Biology, VIB, Brussels, Belgium."}]}},{"fullName":"Tarrasch J","firstName":"Jeffrey","lastName":"Tarrasch","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Life Sciences Institute and Department of Biological Chemistry, University of Michigan Medical School, Ann Arbor, MI, USA."}]}},{"fullName":"Dutta S","firstName":"Somnath","lastName":"Dutta","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-3181-0108"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Life Sciences Institute and Department of Biological Chemistry, University of Michigan Medical School, Ann Arbor, MI, USA."},{"affiliation":"Molecular Biophysics Unit, Indian Institute of Science, Bangalore, India."}]}},{"fullName":"Fonseca R","firstName":"Rasmus","lastName":"Fonseca","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-8322-4880"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Structural Biology, Stanford University School of Medicine, Stanford, CA, USA."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA."},{"affiliation":"Biosciences Division, SLAC National Accelerator Laboratory, Stanford University, Stanford, CA, USA."}]}},{"fullName":"Weis WI","firstName":"William I","lastName":"Weis","initials":"WI","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Structural Biology, Stanford University School of Medicine, Stanford, CA, USA."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA."}]}},{"fullName":"Mathiesen JM","firstName":"Jesper M","lastName":"Mathiesen","initials":"JM","authorId":{"type":"ORCID","value":"0000-0003-4251-4416"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Drug Design and Pharmacology, Faculty of Health and Medical Sciences, University of Copenhagen, Copenhagen, Denmark. jmm@sund.ku.dk."}]}},{"fullName":"Skiniotis G","firstName":"Georgios","lastName":"Skiniotis","initials":"G","authorId":{"type":"ORCID","value":"0000-0003-0238-7846"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Structural Biology, Stanford University School of Medicine, Stanford, CA, USA. yiorgo@stanford.edu."},{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA. yiorgo@stanford.edu."}]}},{"fullName":"Kobilka BK","firstName":"Brian K","lastName":"Kobilka","initials":"BK","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular and Cellular Physiology, Stanford University School of Medicine, Stanford, CA, USA. kobilka@stanford.edu."},{"affiliation":"ConfometRx, Santa Clara, CA, USA. kobilka@stanford.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5001-5065"},{"type":"ORCID","value":"0000-0002-3181-0108"},{"type":"ORCID","value":"0000-0002-3825-874X"},{"type":"ORCID","value":"0000-0002-8322-4880"},{"type":"ORCID","value":"0000-0003-0238-7846"},{"type":"ORCID","value":"0000-0003-2189-0244"},{"type":"ORCID","value":"0000-0003-4251-4416"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","protocols","recommended_reviews","related_data"]},"journalInfo":{"issue":"7742","volume":"566","journalIssueId":2776957,"dateOfPublication":"2019 Feb","monthOfPublication":2,"yearOfPublication":2019,"printPublicationDate":"2019-02-01","journal":{"title":"Nature","medlineAbbreviation":"Nature","essn":"1476-4687","issn":"0028-0836","isoabbreviation":"Nature","nlmid":"0410462"}},"pubYear":"2019","pageInfo":"79-84","abstractText":"Metabotropic glutamate receptors are family C G-protein-coupled receptors. They form obligate dimers and possess extracellular ligand-binding Venus flytrap domains, which are linked by cysteine-rich domains to their 7-transmembrane domains. Spectroscopic studies show that signalling is a dynamic process, in which large-scale conformational changes underlie the transmission of signals from the extracellular Venus flytraps to the G protein-coupling domains-the 7-transmembrane domains-in the membrane. Here, using a combination of X-ray crystallography, cryo-electron microscopy and signalling studies, we present a structural framework for the activation mechanism of metabotropic glutamate receptor subtype 5. Our results show that agonist binding at the Venus flytraps leads to a compaction of the intersubunit dimer interface, thereby bringing the cysteine-rich domains into close proximity. Interactions between the cysteine-rich domains and the second extracellular loops of the receptor enable the rigid-body repositioning of the 7-transmembrane domains, which come into contact with each other to initiate signalling.","affiliation":"Department of Structural Biology, Stanford University School of Medicine, Stanford, CA, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Research Support, U.S. Gov't, Non-P.H.S.","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"grantId":"R01 NS092695","agency":"NINDS NIH HHS","acronym":"NS","orderIn":0},{"grantId":"P41 GM103393","agency":"NIGMS NIH HHS","acronym":"GM","orderIn":0},{"grantId":"R01 NS028471","agency":"NINDS NIH HHS","acronym":"NS","orderIn":0},{"grantId":"NNF15OC0015268","agency":"Novo Nordisk Fonden","orderIn":0},{"grantId":"T32 GM007276","agency":"NIGMS NIH HHS","acronym":"GM","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Cysteine","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Ligands"},{"majorTopic_YN":"N","descriptorName":"Cryoelectron Microscopy"},{"majorTopic_YN":"N","descriptorName":"Crystallography, X-Ray"},{"majorTopic_YN":"Y","descriptorName":"Signal Transduction"},{"majorTopic_YN":"N","descriptorName":"Allosteric Regulation"},{"majorTopic_YN":"N","descriptorName":"Models, Molecular"},{"majorTopic_YN":"N","descriptorName":"Protein Stability"},{"majorTopic_YN":"N","descriptorName":"Receptor, Metabotropic Glutamate 5","meshQualifierList":{"meshQualifier":[{"abbreviation":"ME","qualifierName":"metabolism","majorTopic_YN":"Y"},{"abbreviation":"UL","qualifierName":"ultrastructure","majorTopic_YN":"N"},{"abbreviation":"CH","qualifierName":"chemistry","majorTopic_YN":"Y"}]}},{"majorTopic_YN":"N","descriptorName":"Protein Domains"}]},"chemicalList":{"chemical":[{"name":"Ligands","registryNumber":"0"},{"name":"Cysteine","registryNumber":"K848JZ4886"},{"name":"Receptor, Metabotropic Glutamate 5","registryNumber":"0"},{"name":"GRM5 protein, human","registryNumber":"0"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Unpaywall","url":"http://eprints.iisc.ac.in/62143/1/NAT_567_7747_2019.pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41586-019-0881-4"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC6709600"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC6709600?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"30710123","source":"MED","reference":"Nature. 2019 Feb;566(7742):42-43. doi: 10.1038/d41586-018-07885-x","type":"Comment in","orderIn":1},{"id":"30814739","source":"MED","reference":"Nature. 2019 Mar;567(7747):E10. doi: 10.1038/s41586-019-0983-z","type":"Erratum in","orderIn":2}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":280,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"Y","dbCrossReferenceList":{"dbName":["INTACT","PDB"]},"hasLabsLinks":"Y","hasEvaluations":"N","authMan":"Y","epmcAuthMan":"N","nihAuthMan":"Y","manuscriptId":"NIHMS1516600","hasTMAcce